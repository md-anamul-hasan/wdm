{
  "manifest_version": 3,
  "name": "WDM Integration Module",
  "version": "1.0.0",
  "description": "Windows Download Manager browser integration. Hands file downloads and streaming media to WDM.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "contextMenus",
    "downloads",
    "webRequest",
    "cookies",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "wdm@windowsdownloadmanager.com",
      "strict_min_version": "128.0"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "WDM Download Manager",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  }
}
