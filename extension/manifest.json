{
  "manifest_version": 3,
  "name": "WDM Integration Module",
  "version": "1.0.0",
  "description": "Windows Download Manager browser integration. Intercepts file downloads and captures streaming video and audio.",
  "permissions": [
    "nativeMessaging",
    "contextMenus",
    "downloads",
    "webRequest",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "WDM Download Manager",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  }
}
