{
  "manifest_version": 3,
  "name": "WDM Download Manager Integration",
  "version": "2.0.1",
  "description": "Sends downloads and streaming media from your browser to the free WDM download manager for Windows.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "contextMenus",
    "downloads",
    "webRequest",
    "cookies",
    "storage",
    "activeTab",
    "scripting"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["rules.js", "background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "wdm@windowsdownloadmanager.com",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "WDM Download Manager",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  }
}
