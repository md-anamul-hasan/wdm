{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WDM",
  "version": "2.0.3",
  "identifier": "com.wdm.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../../src-ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "WDM - Windows Download Manager",
        "width": 1180,
        "height": 740,
        "minWidth": 980,
        "minHeight": 560,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/app.png",
      "icons/app.ico"
    ]
  }
}
