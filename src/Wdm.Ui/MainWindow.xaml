<Window x:Class="Wdm.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Wdm.Ui.ViewModels"
        mc:Ignorable="d"
        Title="Internet Download Manager 6.43" Height="700" Width="1060"
        MinHeight="450" MinWidth="750"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/idm_app.png"
        Background="#F0F0F0"
        FontFamily="Segoe UI, Tahoma, MS Sans Serif, sans-serif"
        FontSize="12">

    <Window.DataContext>
        <vm:MainViewModel x:Name="ViewModel" />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Authentic IDM Toolbar Button Style -->
        <Style x:Key="IdmToolbarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="2,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E5F1FB"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#A0D1F8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#CCE4F7"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#62A2E8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Classic Windows Dialog Button -->
        <Style x:Key="ClassicDialogBtn" TargetType="Button">
            <Setter Property="Background" Value="#E1E1E1"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="BorderBrush" Value="#ADADAD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,4"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#E5F1FB"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#0078D7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#CCE4F7"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#005499"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Vertical Separator in Toolbar -->
        <Style x:Key="ToolbarSep" TargetType="Separator">
            <Setter Property="Margin" Value="4,4"/>
            <Setter Property="Width" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Rectangle Width="1" Fill="#B5B5B5" HorizontalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- IDM Classic DataGrid Header -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="#D5D5D5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- IDM Classic DataGrid Row -->
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#F2F2F2"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#3399FF"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsSelected" Value="True"/>
                        <Condition Property="IsFocused" Value="False"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="#C2DFFF"/>
                    <Setter Property="Foreground" Value="#000000"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="#F0F0F0">
        <!-- Main Structure -->
        <DockPanel LastChildFill="True">

            <!-- 1. AUTHENTIC IDM MENU BAR -->
            <Menu DockPanel.Dock="Top" Background="#F0F0F0" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="2">
                <MenuItem Header="_Tasks">
                    <MenuItem Header="_Add new download" InputGestureText="Ctrl+N" Click="OnAddUrlClick">
                        <MenuItem.Icon>
                            <Image Source="Assets/idm_toolbar/add_url.png" Width="16" Height="16"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="_Batch download..."/>
                    <MenuItem Header="Add _batch download from clipboard"/>
                    <Separator/>
                    <MenuItem Header="_Export">
                        <MenuItem Header="To text file..."/>
                        <MenuItem Header="To IDM export file..."/>
                    </MenuItem>
                    <MenuItem Header="_Import">
                        <MenuItem Header="From text file..."/>
                        <MenuItem Header="From IDM export file..."/>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="E_xit" Click="OnCloseClick"/>
                </MenuItem>

                <MenuItem Header="_File">
                    <MenuItem Header="_Stop Download" Click="OnPauseClick"/>
                    <MenuItem Header="_Redownload" Click="OnResumeClick"/>
                    <Separator/>
                    <MenuItem Header="_Delete" Click="OnDeleteClick">
                        <MenuItem.Icon>
                            <Image Source="Assets/idm_toolbar/delete.png" Width="16" Height="16"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Delete _All Completed" Click="OnDeleteCompletedClick">
                        <MenuItem.Icon>
                            <Image Source="Assets/idm_toolbar/delete_completed.png" Width="16" Height="16"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="_Open File" Click="OnOpenFileClick"/>
                    <MenuItem Header="Open _Folder" Click="OnOpenFileLocationClick"/>
                </MenuItem>

                <MenuItem Header="_Downloads">
                    <MenuItem Header="_Pause" Click="OnPauseClick"/>
                    <MenuItem Header="_Resume" Click="OnResumeClick"/>
                    <MenuItem Header="Stop _All" Click="OnStopAllClick">
                        <MenuItem.Icon>
                            <Image Source="Assets/idm_toolbar/stop_all.png" Width="16" Height="16"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="_Delete selected" Click="OnDeleteClick"/>
                    <Separator/>
                    <MenuItem Header="_Speed Limiter">
                        <MenuItem Header="_Turn ON/OFF" IsCheckable="True" IsChecked="{Binding IsSpeedLimiterEnabled}"/>
                        <MenuItem Header="_Settings..."/>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="_Options" Click="OnOpenSettingsClick">
                        <MenuItem.Icon>
                            <Image Source="Assets/idm_toolbar/options.png" Width="16" Height="16"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>

                <MenuItem Header="_View">
                    <MenuItem Header="_Toolbar" IsCheckable="True" IsChecked="True"/>
                    <MenuItem Header="_Categories Tree" IsCheckable="True" IsChecked="True"/>
                    <MenuItem Header="_Status Bar" IsCheckable="True" IsChecked="True"/>
                    <Separator/>
                    <MenuItem Header="_Segment Download Progress Pane" IsCheckable="True" IsChecked="{Binding IsSegmentPanelVisible}" Click="OnToggleSegmentPanelClick"/>
                </MenuItem>

                <MenuItem Header="_Help">
                    <MenuItem Header="_Index" InputGestureText="F1"/>
                    <MenuItem Header="_Tutorials"/>
                    <MenuItem Header="_Quick Update..."/>
                    <Separator/>
                    <MenuItem Header="_About IDM..." Click="OnAboutClick">
                        <MenuItem.Icon>
                            <Image Source="Assets/idm_app.png" Width="16" Height="16"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
            </Menu>

            <!-- 2. AUTHENTIC IDM 3D TOOLBAR -->
            <Border DockPanel.Dock="Top" Background="#F0F0F0" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1" Padding="4,2">
                <ToolBarTray Background="#F0F0F0" IsLocked="True">
                    <ToolBar Background="#F0F0F0" ToolBarTray.IsLocked="True" Loaded="ToolBar_Loaded">
                        <!-- Add URL -->
                        <Button Style="{StaticResource IdmToolbarButton}" Click="OnAddUrlClick" ToolTip="Add URL">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image Source="Assets/idm_toolbar/add_url.png" Width="40" Height="40" HorizontalAlignment="Center" SnapsToDevicePixels="True"/>
                                <TextBlock Text="Add URL" HorizontalAlignment="Center" Margin="0,3,0,0" FontSize="11" Foreground="#000000"/>
                            </StackPanel>
                        </Button>

                        <!-- Resume -->
                        <Button Style="{StaticResource IdmToolbarButton}" Click="OnResumeClick" ToolTip="Resume Download">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image Source="Assets/idm_toolbar/resume.png" Width="40" Height="40" HorizontalAlignment="Center" SnapsToDevicePixels="True"/>
                                <TextBlock Text="Resume" HorizontalAlignment="Center" Margin="0,3,0,0" FontSize="11" Foreground="#000000"/>
                            </StackPanel>
                        </Button>

                        <!-- Stop -->
                        <Button Style="{StaticResource IdmToolbarButton}" Click="OnPauseClick" ToolTip="Stop Download">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image Source="Assets/idm_toolbar/stop.png" Width="40" Height="40" HorizontalAlignment="Center" SnapsToDevicePixels="True"/>
                                <TextBlock Text="Stop" HorizontalAlignment="Center" Margin="0,3,0,0" FontSize="11" Foreground="#000000"/>
                            </StackPanel>
                        </Button>

                        <!-- Stop All -->
                        <Button Style="{StaticResource IdmToolbarButton}" Click="OnStopAllClick" ToolTip="Stop All Downloads">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image Source="Assets/idm_toolbar/stop_all.png" Width="40" Height="40" HorizontalAlignment="Center" SnapsToDevicePixels="True"/>
                                <TextBlock Text="Stop All" HorizontalAlignment="Center" Margin="0,3,0,0" FontSize="11" Foreground="#000000"/>
                            </StackPanel>
                        </Button>

                        <!-- Delete -->
                        <Button Style="{StaticResource IdmToolbarButton}" Click="OnDeleteClick" ToolTip="Delete selected download">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image Source="Assets/idm_toolbar/delete.png" Width="40" Height="40" HorizontalAlignment="Center" SnapsToDevicePixels="True"/>
                                <TextBlock Text="Delete" HorizontalAlignment="Center" Margin="0,3,0,0" FontSize="11" Foreground="#000000"/>
                            </StackPanel>
                        </Button>

                        <!-- Delete Completed -->
                        <Button Style="{StaticResource IdmToolbarButton}" Click="OnDeleteCompletedClick" ToolTip="Delete Completed Downloads">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image Source="Assets/idm_toolbar/delete_completed.png" Width="40" Height="40" HorizontalAlignment="Center" SnapsToDevicePixels="True"/>
                                <TextBlock Text="Delete Comp." HorizontalAlignment="Center" Margin="0,3,0,0" FontSize="11" Foreground="#000000"/>
                            </StackPanel>
                        </Button>

                        <Separator Style="{StaticResource ToolbarSep}"/>

                        <!-- Options -->
                        <Button Style="{StaticResource IdmToolbarButton}" Click="OnOpenSettingsClick" ToolTip="Options">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image Source="Assets/idm_toolbar/options.png" Width="40" Height="40" HorizontalAlignment="Center" SnapsToDevicePixels="True"/>
                                <TextBlock Text="Options" HorizontalAlignment="Center" Margin="0,3,0,0" FontSize="11" Foreground="#000000"/>
                            </StackPanel>
                        </Button>

                        <!-- Scheduler -->
                        <Button Style="{StaticResource IdmToolbarButton}" ToolTip="Scheduler">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image Source="Assets/idm_toolbar/scheduler.png" Width="40" Height="40" HorizontalAlignment="Center" SnapsToDevicePixels="True"/>
                                <TextBlock Text="Scheduler" HorizontalAlignment="Center" Margin="0,3,0,0" FontSize="11" Foreground="#000000"/>
                            </StackPanel>
                        </Button>

                        <!-- Start Queue -->
                        <Button Style="{StaticResource IdmToolbarButton}" ToolTip="Start Queue">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image Source="Assets/idm_toolbar/start_queue.png" Width="40" Height="40" HorizontalAlignment="Center" SnapsToDevicePixels="True"/>
                                <TextBlock Text="Start Queue" HorizontalAlignment="Center" Margin="0,3,0,0" FontSize="11" Foreground="#000000"/>
                            </StackPanel>
                        </Button>

                        <!-- Stop Queue -->
                        <Button Style="{StaticResource IdmToolbarButton}" ToolTip="Stop Queue">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image Source="Assets/idm_toolbar/stop_queue.png" Width="40" Height="40" HorizontalAlignment="Center" SnapsToDevicePixels="True"/>
                                <TextBlock Text="Stop Queue" HorizontalAlignment="Center" Margin="0,3,0,0" FontSize="11" Foreground="#000000"/>
                            </StackPanel>
                        </Button>

                        <Separator Style="{StaticResource ToolbarSep}"/>

                        <!-- Grabber -->
                        <Button Style="{StaticResource IdmToolbarButton}" ToolTip="Site Grabber">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image Source="Assets/idm_toolbar/grabber.png" Width="40" Height="40" HorizontalAlignment="Center" SnapsToDevicePixels="True"/>
                                <TextBlock Text="Grabber" HorizontalAlignment="Center" Margin="0,3,0,0" FontSize="11" Foreground="#000000"/>
                            </StackPanel>
                        </Button>

                        <!-- Tell a Friend -->
                        <Button Style="{StaticResource IdmToolbarButton}" ToolTip="Tell a Friend">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image Source="Assets/idm_toolbar/tell_friend.png" Width="40" Height="40" HorizontalAlignment="Center" SnapsToDevicePixels="True"/>
                                <TextBlock Text="Tell a Friend" HorizontalAlignment="Center" Margin="0,3,0,0" FontSize="11" Foreground="#000000"/>
                            </StackPanel>
                        </Button>
                    </ToolBar>
                </ToolBarTray>
            </Border>

            <!-- 3. AUTHENTIC 3-PANE STATUS BAR -->
            <StatusBar DockPanel.Dock="Bottom" Background="#F0F0F0" BorderBrush="#D0D0D0" BorderThickness="0,1,0,0" Height="24" Padding="4,0">
                <StatusBarItem>
                    <TextBlock Text="{Binding AllCount, StringFormat='{}{0} downloads'}" FontSize="11" Foreground="#333333"/>
                </StatusBarItem>
                <Separator Width="1" Background="#B0B0B0" Margin="4,2"/>
                <StatusBarItem>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Transfer rate: " FontSize="11" Foreground="#333333"/>
                        <TextBlock Text="{Binding TotalSpeedFormatted}" FontSize="11" FontWeight="SemiBold" Foreground="#0055AA"/>
                    </StackPanel>
                </StatusBarItem>
                <Separator Width="1" Background="#B0B0B0" Margin="4,2"/>
                <StatusBarItem HorizontalContentAlignment="Stretch">
                    <TextBlock Text="Ready" FontSize="11" Foreground="#333333"/>
                </StatusBarItem>
            </StatusBar>

            <!-- 4. BOTTOM SEGMENT INSPECTOR (EXPANDABLE) -->
            <Border DockPanel.Dock="Bottom" Background="#F9F9F9" BorderBrush="#D0D0D0" BorderThickness="0,1,0,0"
                    Visibility="{Binding IsSegmentPanelVisible, Converter={StaticResource BoolToVis}}" Height="95" Padding="8,4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,4">
                        <TextBlock Text="Connection Stream Segmentation (Middle-Split Zero-Merge Engine)" 
                                   FontWeight="SemiBold" FontSize="11" Foreground="#333333" DockPanel.Dock="Left"/>
                        <TextBlock Text="{Binding SelectedDownload.FileName, StringFormat='Target: {0}'}" 
                                   FontSize="11" Foreground="#666666" DockPanel.Dock="Right" TextTrimming="CharacterEllipsis" MaxWidth="500"/>
                    </DockPanel>

                    <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#C0C0C0" BorderThickness="1" Padding="4">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding SelectedDownload.Segments}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#B0C4DE" BorderThickness="1" Background="#E8F4F8" 
                                                CornerRadius="2" Margin="3" Padding="4,2" Width="190">
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock Text="{Binding SegmentIndex, StringFormat='Stream #{0}'}" 
                                                               FontSize="10" FontWeight="Bold" Foreground="#004080" DockPanel.Dock="Left"/>
                                                    <TextBlock Text="{Binding Percentage, StringFormat='{}{0:F1}%'}" 
                                                               FontSize="10" FontWeight="SemiBold" Foreground="#006600" DockPanel.Dock="Right"/>
                                                </DockPanel>
                                                <ProgressBar Value="{Binding Percentage, Mode=OneWay}" Maximum="100" Height="8" Margin="0,2" Foreground="#3399FF"/>
                                                <DockPanel>
                                                    <TextBlock Text="{Binding FormattedSpeed}" FontSize="9" Foreground="#555555" DockPanel.Dock="Left"/>
                                                    <TextBlock Text="{Binding FormattedDownloaded}" FontSize="9" Foreground="#555555" DockPanel.Dock="Right"/>
                                                </DockPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>

            <!-- 5. MAIN WORKSPACE: SPLIT LEFT TREEVIEW & RIGHT DATAGRID -->
            <Grid Background="#FFFFFF">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" MinWidth="140" MaxWidth="350"/>
                    <ColumnDefinition Width="3"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Authentic IDM TreeView -->
                <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#D0D0D0" BorderThickness="0,0,1,0">
                    <TreeView x:Name="CategoriesTree" Background="#FFFFFF" BorderThickness="0" 
                              SelectedItemChanged="OnCategoriesTreeSelectedItemChanged" Padding="4">
                        <TreeViewItem Header="Categories" IsExpanded="True" FontWeight="Bold" FontSize="12">
                            <TreeViewItem Header="All Downloads" Tag="All Downloads" IsSelected="True" FontWeight="Normal">
                                <TreeViewItem.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="Assets/idm_app.png" Width="16" Height="16" Margin="0,0,4,0"/>
                                            <TextBlock Text="All Downloads"/>
                                            <TextBlock Text="{Binding DataContext.AllCount, RelativeSource={RelativeSource AncestorType=Window}, StringFormat=' ({0})'}" Foreground="#666666"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </TreeViewItem.HeaderTemplate>
                            </TreeViewItem>

                            <TreeViewItem Header="Compressed" Tag="Compressed" FontWeight="Normal">
                                <TreeViewItem.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="Assets/idm_toolbar/grabber.png" Width="16" Height="16" Margin="0,0,4,0"/>
                                            <TextBlock Text="Compressed"/>
                                            <TextBlock Text="{Binding DataContext.CompressedCount, RelativeSource={RelativeSource AncestorType=Window}, StringFormat=' ({0})'}" Foreground="#666666"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </TreeViewItem.HeaderTemplate>
                            </TreeViewItem>

                            <TreeViewItem Header="Documents" Tag="Documents" FontWeight="Normal">
                                <TreeViewItem.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="Assets/idm_toolbar/tell_friend.png" Width="16" Height="16" Margin="0,0,4,0"/>
                                            <TextBlock Text="Documents"/>
                                            <TextBlock Text="{Binding DataContext.DocumentsCount, RelativeSource={RelativeSource AncestorType=Window}, StringFormat=' ({0})'}" Foreground="#666666"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </TreeViewItem.HeaderTemplate>
                            </TreeViewItem>

                            <TreeViewItem Header="Music" Tag="Music" FontWeight="Normal">
                                <TreeViewItem.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="Assets/idm_toolbar/options.png" Width="16" Height="16" Margin="0,0,4,0"/>
                                            <TextBlock Text="Music"/>
                                            <TextBlock Text="{Binding DataContext.MusicCount, RelativeSource={RelativeSource AncestorType=Window}, StringFormat=' ({0})'}" Foreground="#666666"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </TreeViewItem.HeaderTemplate>
                            </TreeViewItem>

                            <TreeViewItem Header="Programs" Tag="Programs" FontWeight="Normal">
                                <TreeViewItem.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="Assets/idm_toolbar/scheduler.png" Width="16" Height="16" Margin="0,0,4,0"/>
                                            <TextBlock Text="Programs"/>
                                            <TextBlock Text="{Binding DataContext.ProgramsCount, RelativeSource={RelativeSource AncestorType=Window}, StringFormat=' ({0})'}" Foreground="#666666"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </TreeViewItem.HeaderTemplate>
                            </TreeViewItem>

                            <TreeViewItem Header="Video" Tag="Videos" FontWeight="Normal">
                                <TreeViewItem.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="Assets/idm_toolbar/start_queue.png" Width="16" Height="16" Margin="0,0,4,0"/>
                                            <TextBlock Text="Video"/>
                                            <TextBlock Text="{Binding DataContext.VideoCount, RelativeSource={RelativeSource AncestorType=Window}, StringFormat=' ({0})'}" Foreground="#666666"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </TreeViewItem.HeaderTemplate>
                            </TreeViewItem>

                            <TreeViewItem Header="Unfinished" Tag="Unfinished" FontWeight="Normal">
                                <TreeViewItem.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="Assets/idm_toolbar/resume.png" Width="16" Height="16" Margin="0,0,4,0"/>
                                            <TextBlock Text="Unfinished"/>
                                            <TextBlock Text="{Binding DataContext.UnfinishedCount, RelativeSource={RelativeSource AncestorType=Window}, StringFormat=' ({0})'}" Foreground="#666666"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </TreeViewItem.HeaderTemplate>
                            </TreeViewItem>

                            <TreeViewItem Header="Finished" Tag="Finished" FontWeight="Normal">
                                <TreeViewItem.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="Assets/idm_toolbar/delete_completed.png" Width="16" Height="16" Margin="0,0,4,0"/>
                                            <TextBlock Text="Finished"/>
                                            <TextBlock Text="{Binding DataContext.FinishedCount, RelativeSource={RelativeSource AncestorType=Window}, StringFormat=' ({0})'}" Foreground="#666666"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </TreeViewItem.HeaderTemplate>
                            </TreeViewItem>

                            <TreeViewItem Header="Queues" Tag="Queues" IsExpanded="True" FontWeight="Bold">
                                <TreeViewItem Header="Main download queue" Tag="Queues" FontWeight="Normal"/>
                                <TreeViewItem Header="Synchronization queue" Tag="Queues" FontWeight="Normal"/>
                            </TreeViewItem>
                        </TreeViewItem>
                    </TreeView>
                </Border>

                <!-- Splitter -->
                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#E0E0E0" ShowsPreview="True"/>

                <!-- Right: Authentic IDM Downloads DataGrid -->
                <Grid Grid.Column="2" Background="#FFFFFF">
                    <DataGrid x:Name="DownloadsGrid" ItemsSource="{Binding FilteredDownloads}" 
                              SelectedItem="{Binding SelectedDownload, Mode=TwoWay}"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EFEFEF"
                              BorderThickness="0" Background="#FFFFFF" SelectionMode="Single"
                              SelectionUnit="FullRow" HeadersVisibility="Column"
                              RowHeight="26" VerticalScrollBarVisibility="Auto">

                        <!-- Context Menu Matching IDM -->
                        <DataGrid.ContextMenu>
                            <ContextMenu Background="#F0F0F0">
                                <MenuItem Header="Resume Download" Click="OnResumeClick">
                                    <MenuItem.Icon>
                                        <Image Source="Assets/idm_toolbar/resume.png" Width="16" Height="16"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Pause Download" Click="OnPauseClick">
                                    <MenuItem.Icon>
                                        <Image Source="Assets/idm_toolbar/stop.png" Width="16" Height="16"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="Open" Click="OnOpenFileClick"/>
                                <MenuItem Header="Open Directory" Click="OnOpenFileLocationClick"/>
                                <Separator/>
                                <MenuItem Header="Delete" Click="OnDeleteClick">
                                    <MenuItem.Icon>
                                        <Image Source="Assets/idm_toolbar/delete.png" Width="16" Height="16"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Copy URL to clipboard" Click="OnCopyUrlClick"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>

                        <DataGrid.Columns>
                            <!-- File Name -->
                            <DataGridTemplateColumn Header="File Name" Width="240">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                                            <Image Source="Assets/idm_app.png" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Size -->
                            <DataGridTextColumn Header="Size" Binding="{Binding SizeFormatted}" Width="80"/>

                            <!-- Status -->
                            <DataGridTemplateColumn Header="Status" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center" Margin="4,0">
                                            <TextBlock Text="{Binding Status}" FontSize="11" Margin="0,0,0,2"/>
                                            <ProgressBar Value="{Binding ProgressPercentage}" Maximum="100" Height="6" Foreground="#3399FF" Background="#E0E0E0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Time left -->
                            <DataGridTextColumn Header="Time left" Binding="{Binding TimeLeftFormatted}" Width="80"/>

                            <!-- Transfer rate -->
                            <DataGridTextColumn Header="Transfer rate" Binding="{Binding SpeedFormatted}" Width="100"/>

                            <!-- Last Try Date -->
                            <DataGridTextColumn Header="Last Try Date" Binding="{Binding LastTryDate}" Width="130"/>

                            <!-- Description -->
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Watermark if empty -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" 
                                Visibility="{Binding HasNoDownloads, Converter={StaticResource BoolToVis}}">
                        <Image Source="Assets/idm_app.png" Width="48" Height="48" HorizontalAlignment="Center" Margin="0,0,0,10" Opacity="0.6"/>
                        <TextBlock Text="No downloads in this view" FontSize="13" Foreground="#888888" HorizontalAlignment="Center"/>
                        <TextBlock Text="Click 'Add URL' to start a new download" FontSize="11" Foreground="#AAAAAA" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </DockPanel>

        <!-- 6. AUTHENTIC IDM "ENTER NEW ADDRESS TO DOWNLOAD" MODAL DIALOG -->
        <Grid Background="#7F000000" Visibility="{Binding IsAddModalOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="#F0F0F0" BorderBrush="#0055EA" BorderThickness="1" Width="520" 
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="4" Opacity="0.3" Color="#000000"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Title bar -->
                        <RowDefinition Height="*"/>    <!-- Body -->
                    </Grid.RowDefinitions>

                    <!-- Classic IDM Window Header -->
                    <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#DFDFDF" BorderThickness="0,0,0,1" Padding="8,6">
                        <DockPanel>
                            <Image Source="Assets/idm_toolbar/add_url.png" Width="20" Height="20" Margin="0,0,6,0" DockPanel.Dock="Left"/>
                            <TextBlock Text="Enter new address to download" FontWeight="SemiBold" FontSize="12" Foreground="#000000" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                            <Button Content="r" FontFamily="Marlett" FontSize="10" Width="20" Height="18" Click="OnCancelModalClick" DockPanel.Dock="Right" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0"/>
                        </DockPanel>
                    </Border>

                    <!-- Body -->
                    <StackPanel Grid.Row="1" Margin="14,12">
                        <!-- YouTube detection banner -->
                        <Border Background="#FFFFE1" BorderBrush="#E6DB55" BorderThickness="1" Padding="8,6" Margin="0,0,0,10"
                                Visibility="{Binding IsYouTubeUrl, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="Assets/idm_toolbar/grabber.png" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="YouTube Video Stream Detected - IDM engine will extract and merge highest quality video stream." 
                                           FontSize="11" Foreground="#000000" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Address:" FontSize="11" Foreground="#000000" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NewDownloadUrl, UpdateSourceTrigger=PropertyChanged}" 
                                 Background="#FFFFFF" Foreground="#000000" BorderBrush="#7A9EA9" BorderThickness="1" 
                                 Padding="4,3" FontSize="12" Margin="0,0,0,10"/>

                        <TextBlock Text="Save to directory:" FontSize="11" Foreground="#000000" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding NewDownloadDir, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="#FFFFFF" Foreground="#000000" BorderBrush="#7A9EA9" BorderThickness="1" 
                                     Padding="4,3" FontSize="11"/>
                            <Button Grid.Column="1" Content="..." Width="28" Height="24" Margin="4,0,0,0" 
                                    Style="{StaticResource ClassicDialogBtn}" Click="OnBrowseFolderClick"/>
                        </Grid>

                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="Max connection number:" FontSize="11" Foreground="#000000" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding NewDownloadConnections, StringFormat='{}{0} streams'}" FontWeight="Bold" FontSize="11" Foreground="#0055AA" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Slider Minimum="1" Maximum="32" Value="{Binding NewDownloadConnections}" Margin="0,0,0,16"/>

                        <!-- Action Buttons -->
                        <DockPanel LastChildFill="False">
                            <Button Content="OK" Width="75" Height="23" Style="{StaticResource ClassicDialogBtn}" 
                                    Click="OnConfirmModalClick" DockPanel.Dock="Right" Margin="6,0,0,0" IsDefault="True"/>
                            <Button Content="Cancel" Width="75" Height="23" Style="{StaticResource ClassicDialogBtn}" 
                                    Click="OnCancelModalClick" DockPanel.Dock="Right" IsCancel="True"/>
                        </DockPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 7. AUTHENTIC IDM OPTIONS / CONFIGURATION MODAL DIALOG -->
        <Grid Background="#7F000000" Visibility="{Binding IsSettingsModalOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="#F0F0F0" BorderBrush="#0055EA" BorderThickness="1" Width="550" 
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="4" Opacity="0.3" Color="#000000"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Title bar -->
                    <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#DFDFDF" BorderThickness="0,0,0,1" Padding="8,6">
                        <DockPanel>
                            <Image Source="Assets/idm_toolbar/options.png" Width="20" Height="20" Margin="0,0,6,0" DockPanel.Dock="Left"/>
                            <TextBlock Text="Internet Download Manager Configuration" FontWeight="SemiBold" FontSize="12" Foreground="#000000" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                            <Button Content="r" FontFamily="Marlett" FontSize="10" Width="20" Height="18" Click="OnCancelSettingsClick" DockPanel.Dock="Right" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0"/>
                        </DockPanel>
                    </Border>

                    <TabControl Grid.Row="1" Background="#F0F0F0" Margin="8">
                        <TabItem Header="General">
                            <StackPanel Margin="10">
                                <GroupBox Header="Default Download Directory" Margin="0,0,0,10" Padding="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding Settings.DefaultDownloadDirectory, UpdateSourceTrigger=PropertyChanged}" 
                                                 Background="#FFFFFF" Foreground="#000000" BorderBrush="#7A9EA9" BorderThickness="1" Padding="4,2"/>
                                        <Button Grid.Column="1" Content="Browse..." Margin="4,0,0,0" Style="{StaticResource ClassicDialogBtn}" Click="OnBrowseSettingsFolderClick"/>
                                    </Grid>
                                </GroupBox>

                                <GroupBox Header="Options" Margin="0,0,0,10" Padding="8">
                                    <StackPanel>
                                        <CheckBox Content="Automatically open completed files" IsChecked="{Binding Settings.AutoOpenFileOnComplete}" Margin="0,0,0,6"/>
                                        <CheckBox Content="Confirm before deleting downloads" IsChecked="{Binding Settings.ConfirmBeforeDelete}"/>
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>
                        </TabItem>

                        <TabItem Header="Connection">
                            <StackPanel Margin="10">
                                <GroupBox Header="Connection Type / Speed" Margin="0,0,0,10" Padding="8">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock Text="Default max. connection number:" FontSize="11" Foreground="#000000" DockPanel.Dock="Left"/>
                                            <TextBlock Text="{Binding Settings.DefaultConnections, StringFormat='{}{0}'}" FontWeight="Bold" FontSize="11" Foreground="#0055AA" DockPanel.Dock="Right"/>
                                        </DockPanel>
                                        <Slider Minimum="1" Maximum="32" Value="{Binding Settings.DefaultConnections}" Margin="0,0,0,8"/>

                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock Text="Max Concurrent Downloads:" FontSize="11" Foreground="#000000" DockPanel.Dock="Left"/>
                                            <TextBlock Text="{Binding Settings.MaxConcurrentDownloads, StringFormat='{}{0}'}" FontWeight="Bold" FontSize="11" Foreground="#0055AA" DockPanel.Dock="Right"/>
                                        </DockPanel>
                                        <Slider Minimum="1" Maximum="10" Value="{Binding Settings.MaxConcurrentDownloads}" Margin="0,0,0,8"/>

                                        <CheckBox Content="Enable Dynamic Middle-Split Load Balancing (IDM Parity)" IsChecked="{Binding Settings.EnableDynamicMiddleSplit}"/>
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="Speed Limiter" Padding="8">
                                    <StackPanel>
                                        <CheckBox Content="Enable Speed Limiter" IsChecked="{Binding IsSpeedLimiterEnabled}" Margin="0,0,0,6"/>
                                        <DockPanel>
                                            <TextBlock Text="Maximum Download Speed:" FontSize="11" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding SpeedLimitKb, UpdateSourceTrigger=PropertyChanged}" Width="70" DockPanel.Dock="Right" Margin="6,0,0,0"/>
                                            <TextBlock Text="KB/s" FontSize="11" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
