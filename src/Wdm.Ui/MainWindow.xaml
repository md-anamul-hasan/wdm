<Window x:Class="Wdm.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Wdm.Ui.ViewModels"
        mc:Ignorable="d"
        Title="Internet Download Manager 6.43" Height="700" Width="1060"
        MinHeight="450" MinWidth="750"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/app.png"
        Background="#F5F6F8"
        FontFamily="Segoe UI, -apple-system, BlinkMacSystemFont, sans-serif"
        FontSize="12">

    <Window.DataContext>
        <vm:MainViewModel x:Name="ViewModel" />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Modern Clean Monochromatic Toolbar Button Style -->
        <Style x:Key="IdmModernToolbarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="2,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E9ECEF"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#CED4DA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#DEE2E6"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#ADB5BD"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean Modern Dialog Button -->
        <Style x:Key="ClassicDialogBtn" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#212529"/>
            <Setter Property="BorderBrush" Value="#CED4DA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,5"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#F8F9FA"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#0D6EFD"/>
                                <Setter Property="Foreground" Value="#0D6EFD"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#E9ECEF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryDialogBtn" TargetType="Button" BasedOn="{StaticResource ClassicDialogBtn}">
            <Setter Property="Background" Value="#0D6EFD"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#0D6EFD"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#0B5ED7"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#0A58CA"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#0A58CA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Vertical Separator in Toolbar -->
        <Style x:Key="ToolbarSep" TargetType="Separator">
            <Setter Property="Margin" Value="6,8"/>
            <Setter Property="Width" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Rectangle Width="1" Fill="#DEE2E6" HorizontalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern DataGrid Header -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8F9FA"/>
            <Setter Property="Foreground" Value="#495057"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="#E9ECEF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean DataGrid Row -->
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#212529"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#F1F3F5"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E7F1FF"/>
                    <Setter Property="Foreground" Value="#0C63E4"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="#F5F6F8">
        <!-- Main Structure -->
        <DockPanel LastChildFill="True">

            <!-- 1. AUTHENTIC IDM MENU BAR WITH MONOCHROMATIC ICONS -->
            <Menu DockPanel.Dock="Top" Background="#FFFFFF" BorderBrush="#E9ECEF" BorderThickness="0,0,0,1" Padding="4,2">
                <MenuItem Header="_Tasks">
                    <MenuItem Header="_Add new download" InputGestureText="Ctrl+N" Click="OnAddUrlClick">
                        <MenuItem.Icon>
                            <Path Data="{StaticResource IconAddUrl}" Fill="#2B303A" Width="14" Height="14" Stretch="Uniform"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="_Batch download..."/>
                    <MenuItem Header="Add _batch download from clipboard"/>
                    <Separator/>
                    <MenuItem Header="_Export">
                        <MenuItem Header="To text file..."/>
                        <MenuItem Header="To IDM export file..."/>
                    </MenuItem>
                    <MenuItem Header="_Import">
                        <MenuItem Header="From text file..."/>
                        <MenuItem Header="From IDM export file..."/>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="E_xit" Click="OnCloseClick"/>
                </MenuItem>

                <MenuItem Header="_File">
                    <MenuItem Header="_Stop Download" Click="OnPauseClick">
                        <MenuItem.Icon>
                            <Path Data="{StaticResource IconStop}" Fill="#2B303A" Width="13" Height="13" Stretch="Uniform"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="_Redownload" Click="OnResumeClick">
                        <MenuItem.Icon>
                            <Path Data="{StaticResource IconResume}" Fill="#2B303A" Width="13" Height="13" Stretch="Uniform"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="_Delete" Click="OnDeleteClick">
                        <MenuItem.Icon>
                            <Path Data="{StaticResource IconDelete}" Fill="#2B303A" Width="13" Height="13" Stretch="Uniform"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Delete _All Completed" Click="OnDeleteCompletedClick">
                        <MenuItem.Icon>
                            <Path Data="{StaticResource IconDeleteCompleted}" Fill="#2B303A" Width="13" Height="13" Stretch="Uniform"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="_Open File" Click="OnOpenFileClick"/>
                    <MenuItem Header="Open _Folder" Click="OnOpenFileLocationClick"/>
                </MenuItem>

                <MenuItem Header="_Downloads">
                    <MenuItem Header="_Pause" Click="OnPauseClick"/>
                    <MenuItem Header="_Resume" Click="OnResumeClick"/>
                    <MenuItem Header="Stop _All" Click="OnStopAllClick">
                        <MenuItem.Icon>
                            <Path Data="{StaticResource IconStopAll}" Fill="#2B303A" Width="13" Height="13" Stretch="Uniform"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="_Delete selected" Click="OnDeleteClick"/>
                    <Separator/>
                    <MenuItem Header="_Speed Limiter">
                        <MenuItem Header="_Turn ON/OFF" IsCheckable="True" IsChecked="{Binding IsSpeedLimiterEnabled}"/>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="_Options" Click="OnOpenSettingsClick">
                        <MenuItem.Icon>
                            <Path Data="{StaticResource IconOptions}" Fill="#2B303A" Width="13" Height="13" Stretch="Uniform"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>

                <MenuItem Header="_View">
                    <MenuItem Header="_Toolbar" IsCheckable="True" IsChecked="True"/>
                    <MenuItem Header="_Categories Tree" IsCheckable="True" IsChecked="True"/>
                    <MenuItem Header="_Status Bar" IsCheckable="True" IsChecked="True"/>
                    <Separator/>
                    <MenuItem Header="_Segment Download Progress Pane" IsCheckable="True" IsChecked="{Binding IsSegmentPanelVisible}" Click="OnToggleSegmentPanelClick"/>
                </MenuItem>

                <MenuItem Header="_Help">
                    <MenuItem Header="_Index" InputGestureText="F1"/>
                    <MenuItem Header="_About IDM..." Click="OnAboutClick">
                        <MenuItem.Icon>
                            <Path Data="{StaticResource IconFile}" Fill="#2B303A" Width="13" Height="13" Stretch="Uniform"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
            </Menu>

            <!-- 2. MODERN MONOCHROMATIC IDM TOOLBAR -->
            <Border DockPanel.Dock="Top" Background="#FFFFFF" BorderBrush="#E9ECEF" BorderThickness="0,0,0,1" Padding="6,4">
                <ToolBarTray Background="#FFFFFF" IsLocked="True">
                    <ToolBar Background="#FFFFFF" ToolBarTray.IsLocked="True" Loaded="ToolBar_Loaded">
                        <!-- Add URL -->
                        <Button Style="{StaticResource IdmModernToolbarButton}" Click="OnAddUrlClick" ToolTip="Add URL">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="38" Height="34" HorizontalAlignment="Center">
                                    <Path Data="{StaticResource IconAddUrl}" Fill="#1E293B" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Add URL" HorizontalAlignment="Center" Margin="0,3,0,0" FontSize="11" FontWeight="Medium" Foreground="#334155"/>
                            </StackPanel>
                        </Button>

                        <!-- Resume -->
                        <Button Style="{StaticResource IdmModernToolbarButton}" Click="OnResumeClick" ToolTip="Resume Download">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="38" Height="34" HorizontalAlignment="Center">
                                    <Path Data="{StaticResource IconResume}" Fill="#1E293B" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Resume" HorizontalAlignment="Center" Margin="0,3,0,0" FontSize="11" FontWeight="Medium" Foreground="#334155"/>
                            </StackPanel>
                        </Button>

                        <!-- Stop -->
                        <Button Style="{StaticResource IdmModernToolbarButton}" Click="OnPauseClick" ToolTip="Stop Download">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="38" Height="34" HorizontalAlignment="Center">
                                    <Path Data="{StaticResource IconStop}" Fill="#1E293B" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Stop" HorizontalAlignment="Center" Margin="0,3,0,0" FontSize="11" FontWeight="Medium" Foreground="#334155"/>
                            </StackPanel>
                        </Button>

                        <!-- Stop All -->
                        <Button Style="{StaticResource IdmModernToolbarButton}" Click="OnStopAllClick" ToolTip="Stop All Downloads">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="38" Height="34" HorizontalAlignment="Center">
                                    <Path Data="{StaticResource IconStopAll}" Fill="#1E293B" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Stop All" HorizontalAlignment="Center" Margin="0,3,0,0" FontSize="11" FontWeight="Medium" Foreground="#334155"/>
                            </StackPanel>
                        </Button>

                        <!-- Delete -->
                        <Button Style="{StaticResource IdmModernToolbarButton}" Click="OnDeleteClick" ToolTip="Delete selected download">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="38" Height="34" HorizontalAlignment="Center">
                                    <Path Data="{StaticResource IconDelete}" Fill="#1E293B" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Delete" HorizontalAlignment="Center" Margin="0,3,0,0" FontSize="11" FontWeight="Medium" Foreground="#334155"/>
                            </StackPanel>
                        </Button>

                        <!-- Delete Completed -->
                        <Button Style="{StaticResource IdmModernToolbarButton}" Click="OnDeleteCompletedClick" ToolTip="Delete Completed Downloads">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="38" Height="34" HorizontalAlignment="Center">
                                    <Path Data="{StaticResource IconDeleteCompleted}" Fill="#1E293B" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Delete Comp." HorizontalAlignment="Center" Margin="0,3,0,0" FontSize="11" FontWeight="Medium" Foreground="#334155"/>
                            </StackPanel>
                        </Button>

                        <Separator Style="{StaticResource ToolbarSep}"/>

                        <!-- Options -->
                        <Button Style="{StaticResource IdmModernToolbarButton}" Click="OnOpenSettingsClick" ToolTip="Options">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="38" Height="34" HorizontalAlignment="Center">
                                    <Path Data="{StaticResource IconOptions}" Fill="#1E293B" Width="23" Height="23" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Options" HorizontalAlignment="Center" Margin="0,3,0,0" FontSize="11" FontWeight="Medium" Foreground="#334155"/>
                            </StackPanel>
                        </Button>

                        <!-- Scheduler -->
                        <Button Style="{StaticResource IdmModernToolbarButton}" ToolTip="Scheduler">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="38" Height="34" HorizontalAlignment="Center">
                                    <Path Data="{StaticResource IconScheduler}" Fill="#1E293B" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Scheduler" HorizontalAlignment="Center" Margin="0,3,0,0" FontSize="11" FontWeight="Medium" Foreground="#334155"/>
                            </StackPanel>
                        </Button>

                        <!-- Start Queue -->
                        <Button Style="{StaticResource IdmModernToolbarButton}" ToolTip="Start Queue">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="38" Height="34" HorizontalAlignment="Center">
                                    <Path Data="{StaticResource IconStartQueue}" Fill="#1E293B" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Start Queue" HorizontalAlignment="Center" Margin="0,3,0,0" FontSize="11" FontWeight="Medium" Foreground="#334155"/>
                            </StackPanel>
                        </Button>

                        <!-- Stop Queue -->
                        <Button Style="{StaticResource IdmModernToolbarButton}" ToolTip="Stop Queue">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="38" Height="34" HorizontalAlignment="Center">
                                    <Path Data="{StaticResource IconStopQueue}" Fill="#1E293B" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Stop Queue" HorizontalAlignment="Center" Margin="0,3,0,0" FontSize="11" FontWeight="Medium" Foreground="#334155"/>
                            </StackPanel>
                        </Button>

                        <Separator Style="{StaticResource ToolbarSep}"/>

                        <!-- Grabber -->
                        <Button Style="{StaticResource IdmModernToolbarButton}" ToolTip="Site Grabber">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="38" Height="34" HorizontalAlignment="Center">
                                    <Path Data="{StaticResource IconGrabber}" Stroke="#1E293B" StrokeThickness="1.5" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Grabber" HorizontalAlignment="Center" Margin="0,3,0,0" FontSize="11" FontWeight="Medium" Foreground="#334155"/>
                            </StackPanel>
                        </Button>

                        <!-- Tell a Friend -->
                        <Button Style="{StaticResource IdmModernToolbarButton}" ToolTip="Tell a Friend">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="38" Height="34" HorizontalAlignment="Center">
                                    <Path Data="{StaticResource IconTellFriend}" Fill="#1E293B" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Tell a Friend" HorizontalAlignment="Center" Margin="0,3,0,0" FontSize="11" FontWeight="Medium" Foreground="#334155"/>
                            </StackPanel>
                        </Button>
                    </ToolBar>
                </ToolBarTray>
            </Border>

            <!-- 3. AUTHENTIC 3-PANE STATUS BAR -->
            <StatusBar DockPanel.Dock="Bottom" Background="#FFFFFF" BorderBrush="#E9ECEF" BorderThickness="0,1,0,0" Height="26" Padding="8,0">
                <StatusBarItem>
                    <TextBlock Text="{Binding AllCount, StringFormat='{}{0} downloads'}" FontSize="11" Foreground="#495057"/>
                </StatusBarItem>
                <Separator Width="1" Background="#DEE2E6" Margin="6,3"/>
                <StatusBarItem>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Transfer rate: " FontSize="11" Foreground="#495057"/>
                        <TextBlock Text="{Binding TotalSpeedFormatted}" FontSize="11" FontWeight="SemiBold" Foreground="#0D6EFD"/>
                    </StackPanel>
                </StatusBarItem>
                <Separator Width="1" Background="#DEE2E6" Margin="6,3"/>
                <StatusBarItem HorizontalContentAlignment="Stretch">
                    <TextBlock Text="Ready" FontSize="11" Foreground="#495057"/>
                </StatusBarItem>
            </StatusBar>

            <!-- 4. BOTTOM SEGMENT INSPECTOR (EXPANDABLE) -->
            <Border DockPanel.Dock="Bottom" Background="#F8F9FA" BorderBrush="#E9ECEF" BorderThickness="0,1,0,0"
                    Visibility="{Binding IsSegmentPanelVisible, Converter={StaticResource BoolToVis}}" Height="95" Padding="10,6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                        <TextBlock Text="Connection Stream Segmentation (Middle-Split Zero-Merge Engine)" 
                                   FontWeight="SemiBold" FontSize="11.5" Foreground="#212529" DockPanel.Dock="Left"/>
                        <TextBlock Text="{Binding SelectedDownload.FileName, StringFormat='Target: {0}'}" 
                                   FontSize="11" Foreground="#6C757D" DockPanel.Dock="Right" TextTrimming="CharacterEllipsis" MaxWidth="500"/>
                    </DockPanel>

                    <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="4" Padding="4">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding SelectedDownload.Segments}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#E9ECEF" BorderThickness="1" Background="#F8F9FA" 
                                                CornerRadius="4" Margin="3" Padding="6,3" Width="190">
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock Text="{Binding SegmentIndex, StringFormat='Stream #{0}'}" 
                                                               FontSize="10" FontWeight="Bold" Foreground="#1E293B" DockPanel.Dock="Left"/>
                                                    <TextBlock Text="{Binding Percentage, StringFormat='{}{0:F1}%'}" 
                                                               FontSize="10" FontWeight="SemiBold" Foreground="#0D6EFD" DockPanel.Dock="Right"/>
                                                </DockPanel>
                                                <ProgressBar Value="{Binding Percentage, Mode=OneWay}" Maximum="100" Height="6" Margin="0,3" Foreground="#0D6EFD" Background="#DEE2E6"/>
                                                <DockPanel>
                                                    <TextBlock Text="{Binding FormattedSpeed}" FontSize="9" Foreground="#6C757D" DockPanel.Dock="Left"/>
                                                    <TextBlock Text="{Binding FormattedDownloaded}" FontSize="9" Foreground="#6C757D" DockPanel.Dock="Right"/>
                                                </DockPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>

            <!-- 5. MAIN WORKSPACE: SPLIT LEFT TREEVIEW & RIGHT DATAGRID -->
            <Grid Background="#FFFFFF">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" MinWidth="140" MaxWidth="350"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Monochromatic TreeView -->
                <Border Grid.Column="0" Background="#F8F9FA" BorderBrush="#E9ECEF" BorderThickness="0,0,1,0">
                    <TreeView x:Name="CategoriesTree" Background="Transparent" BorderThickness="0" 
                              SelectedItemChanged="OnCategoriesTreeSelectedItemChanged" Padding="6">
                        <TreeViewItem Header="Categories" IsExpanded="True" FontWeight="SemiBold" FontSize="12">
                            <TreeViewItem Header="All Downloads" Tag="All Downloads" IsSelected="True" FontWeight="Normal" Margin="0,2">
                                <TreeViewItem.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconCategoryAll}" Fill="#495057" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="All Downloads" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding DataContext.AllCount, RelativeSource={RelativeSource AncestorType=Window}, StringFormat=' ({0})'}" Foreground="#6C757D" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </TreeViewItem.HeaderTemplate>
                            </TreeViewItem>

                            <TreeViewItem Header="Compressed" Tag="Compressed" FontWeight="Normal" Margin="0,2">
                                <TreeViewItem.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconCategoryCompressed}" Fill="#495057" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Compressed" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding DataContext.CompressedCount, RelativeSource={RelativeSource AncestorType=Window}, StringFormat=' ({0})'}" Foreground="#6C757D" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </TreeViewItem.HeaderTemplate>
                            </TreeViewItem>

                            <TreeViewItem Header="Documents" Tag="Documents" FontWeight="Normal" Margin="0,2">
                                <TreeViewItem.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconCategoryDocuments}" Fill="#495057" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Documents" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding DataContext.DocumentsCount, RelativeSource={RelativeSource AncestorType=Window}, StringFormat=' ({0})'}" Foreground="#6C757D" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </TreeViewItem.HeaderTemplate>
                            </TreeViewItem>

                            <TreeViewItem Header="Music" Tag="Music" FontWeight="Normal" Margin="0,2">
                                <TreeViewItem.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconCategoryMusic}" Fill="#495057" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Music" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding DataContext.MusicCount, RelativeSource={RelativeSource AncestorType=Window}, StringFormat=' ({0})'}" Foreground="#6C757D" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </TreeViewItem.HeaderTemplate>
                            </TreeViewItem>

                            <TreeViewItem Header="Programs" Tag="Programs" FontWeight="Normal" Margin="0,2">
                                <TreeViewItem.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconCategoryPrograms}" Fill="#495057" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Programs" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding DataContext.ProgramsCount, RelativeSource={RelativeSource AncestorType=Window}, StringFormat=' ({0})'}" Foreground="#6C757D" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </TreeViewItem.HeaderTemplate>
                            </TreeViewItem>

                            <TreeViewItem Header="Video" Tag="Videos" FontWeight="Normal" Margin="0,2">
                                <TreeViewItem.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconCategoryVideo}" Fill="#495057" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Video" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding DataContext.VideoCount, RelativeSource={RelativeSource AncestorType=Window}, StringFormat=' ({0})'}" Foreground="#6C757D" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </TreeViewItem.HeaderTemplate>
                            </TreeViewItem>

                            <TreeViewItem Header="Unfinished" Tag="Unfinished" FontWeight="Normal" Margin="0,2">
                                <TreeViewItem.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconCategoryUnfinished}" Fill="#495057" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Unfinished" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding DataContext.UnfinishedCount, RelativeSource={RelativeSource AncestorType=Window}, StringFormat=' ({0})'}" Foreground="#6C757D" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </TreeViewItem.HeaderTemplate>
                            </TreeViewItem>

                            <TreeViewItem Header="Finished" Tag="Finished" FontWeight="Normal" Margin="0,2">
                                <TreeViewItem.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconCategoryFinished}" Fill="#495057" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Finished" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding DataContext.FinishedCount, RelativeSource={RelativeSource AncestorType=Window}, StringFormat=' ({0})'}" Foreground="#6C757D" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </TreeViewItem.HeaderTemplate>
                            </TreeViewItem>

                            <TreeViewItem Header="Queues" Tag="Queues" IsExpanded="True" FontWeight="SemiBold" Margin="0,4,0,2">
                                <TreeViewItem.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconCategoryQueues}" Fill="#495057" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Queues" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </TreeViewItem.HeaderTemplate>
                                <TreeViewItem Header="Main download queue" Tag="Queues" FontWeight="Normal"/>
                                <TreeViewItem Header="Synchronization queue" Tag="Queues" FontWeight="Normal"/>
                            </TreeViewItem>
                        </TreeViewItem>
                    </TreeView>
                </Border>

                <!-- Splitter -->
                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#E9ECEF" ShowsPreview="True"/>

                <!-- Right: Monochromatic Downloads DataGrid -->
                <Grid Grid.Column="2" Background="#FFFFFF">
                    <DataGrid x:Name="DownloadsGrid" ItemsSource="{Binding FilteredDownloads}" 
                              SelectedItem="{Binding SelectedDownload, Mode=TwoWay}"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F3F5"
                              BorderThickness="0" Background="#FFFFFF" SelectionMode="Single"
                              SelectionUnit="FullRow" HeadersVisibility="Column"
                              RowHeight="28" VerticalScrollBarVisibility="Auto">

                        <!-- Context Menu -->
                        <DataGrid.ContextMenu>
                            <ContextMenu Background="#FFFFFF" BorderBrush="#DEE2E6">
                                <MenuItem Header="Resume Download" Click="OnResumeClick">
                                    <MenuItem.Icon>
                                        <Path Data="{StaticResource IconResume}" Fill="#2B303A" Width="13" Height="13" Stretch="Uniform"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Pause Download" Click="OnPauseClick">
                                    <MenuItem.Icon>
                                        <Path Data="{StaticResource IconStop}" Fill="#2B303A" Width="13" Height="13" Stretch="Uniform"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="Open" Click="OnOpenFileClick"/>
                                <MenuItem Header="Open Directory" Click="OnOpenFileLocationClick"/>
                                <Separator/>
                                <MenuItem Header="Delete" Click="OnDeleteClick">
                                    <MenuItem.Icon>
                                        <Path Data="{StaticResource IconDelete}" Fill="#2B303A" Width="13" Height="13" Stretch="Uniform"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Copy URL to clipboard" Click="OnCopyUrlClick"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>

                        <DataGrid.Columns>
                            <!-- File Name with Clean Monochromatic Icon -->
                            <DataGridTemplateColumn Header="File Name" Width="260">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                                            <Path Data="{StaticResource IconFile}" Fill="#495057" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontWeight="Medium"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Size -->
                            <DataGridTextColumn Header="Size" Binding="{Binding SizeFormatted}" Width="85"/>

                            <!-- Status -->
                            <DataGridTemplateColumn Header="Status" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center" Margin="6,0">
                                            <TextBlock Text="{Binding Status}" FontSize="11" Margin="0,0,0,2" Foreground="#495057"/>
                                            <ProgressBar Value="{Binding ProgressPercentage}" Maximum="100" Height="5" Foreground="#0D6EFD" Background="#E9ECEF"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Time left -->
                            <DataGridTextColumn Header="Time left" Binding="{Binding TimeLeftFormatted}" Width="80"/>

                            <!-- Transfer rate -->
                            <DataGridTextColumn Header="Transfer rate" Binding="{Binding SpeedFormatted}" Width="100"/>

                            <!-- Last Try Date -->
                            <DataGridTextColumn Header="Last Try Date" Binding="{Binding LastTryDate}" Width="130"/>

                            <!-- Description -->
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Watermark if empty -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" 
                                Visibility="{Binding HasNoDownloads, Converter={StaticResource BoolToVis}}">
                        <Path Data="{StaticResource IconAddUrl}" Fill="#CED4DA" Width="48" Height="48" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock Text="No downloads in this view" FontSize="14" FontWeight="Medium" Foreground="#6C757D" HorizontalAlignment="Center"/>
                        <TextBlock Text="Click 'Add URL' to start a new download" FontSize="12" Foreground="#ADB5BD" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </DockPanel>

        <!-- 6. MODAL DIALOG: "ENTER NEW ADDRESS TO DOWNLOAD" -->
        <Grid Background="#7F000000" Visibility="{Binding IsAddModalOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="#FFFFFF" BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="8" Width="520" 
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.18" Color="#000000"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Dialog Header -->
                    <Border Grid.Row="0" Background="#F8F9FA" BorderBrush="#E9ECEF" BorderThickness="0,0,0,1" CornerRadius="8,8,0,0" Padding="14,10">
                        <DockPanel>
                            <Path Data="{StaticResource IconAddUrl}" Fill="#0D6EFD" Width="18" Height="18" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                            <TextBlock Text="Enter new address to download" FontWeight="SemiBold" FontSize="13" Foreground="#212529" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                            <Button Content="✕" FontSize="12" Width="22" Height="22" Click="OnCancelModalClick" DockPanel.Dock="Right" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Foreground="#6C757D" Cursor="Hand"/>
                        </DockPanel>
                    </Border>

                    <!-- Body -->
                    <StackPanel Grid.Row="1" Margin="18,14">
                        <!-- YouTube detection banner -->
                        <Border Background="#E7F1FF" BorderBrush="#B6D4FE" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,12"
                                Visibility="{Binding IsYouTubeUrl, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconCategoryVideo}" Fill="#0D6EFD" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="YouTube Video Stream Detected - Engine will extract and mux highest quality stream." 
                                           FontSize="11.5" Foreground="#084298" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Address:" FontSize="11.5" FontWeight="Medium" Foreground="#495057" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding NewDownloadUrl, UpdateSourceTrigger=PropertyChanged}" 
                                 Background="#FFFFFF" Foreground="#212529" BorderBrush="#CED4DA" BorderThickness="1" 
                                 Padding="8,6" FontSize="12" Margin="0,0,0,12"/>

                        <TextBlock Text="Save to directory:" FontSize="11.5" FontWeight="Medium" Foreground="#495057" Margin="0,0,0,5"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding NewDownloadDir, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="#FFFFFF" Foreground="#212529" BorderBrush="#CED4DA" BorderThickness="1" 
                                     Padding="8,5" FontSize="11.5"/>
                            <Button Grid.Column="1" Content="Browse..." Margin="6,0,0,0" 
                                    Style="{StaticResource ClassicDialogBtn}" Click="OnBrowseFolderClick"/>
                        </Grid>

                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="Max connection number:" FontSize="11.5" FontWeight="Medium" Foreground="#495057" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding NewDownloadConnections, StringFormat='{}{0} streams'}" FontWeight="Bold" FontSize="11.5" Foreground="#0D6EFD" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Slider Minimum="1" Maximum="32" Value="{Binding NewDownloadConnections}" Margin="0,0,0,18"/>

                        <!-- Action Buttons -->
                        <DockPanel LastChildFill="False">
                            <Button Content="Download Now" Style="{StaticResource PrimaryDialogBtn}" 
                                    Click="OnConfirmModalClick" DockPanel.Dock="Right" Margin="8,0,0,0" IsDefault="True"/>
                            <Button Content="Cancel" Style="{StaticResource ClassicDialogBtn}" 
                                    Click="OnCancelModalClick" DockPanel.Dock="Right" IsCancel="True"/>
                        </DockPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 7. MODAL DIALOG: OPTIONS / CONFIGURATION -->
        <Grid Background="#7F000000" Visibility="{Binding IsSettingsModalOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="#FFFFFF" BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="8" Width="550" 
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.18" Color="#000000"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Title bar -->
                    <Border Grid.Row="0" Background="#F8F9FA" BorderBrush="#E9ECEF" BorderThickness="0,0,0,1" CornerRadius="8,8,0,0" Padding="14,10">
                        <DockPanel>
                            <Path Data="{StaticResource IconOptions}" Fill="#0D6EFD" Width="18" Height="18" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                            <TextBlock Text="Internet Download Manager Configuration" FontWeight="SemiBold" FontSize="13" Foreground="#212529" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                            <Button Content="✕" FontSize="12" Width="22" Height="22" Click="OnCancelSettingsClick" DockPanel.Dock="Right" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Foreground="#6C757D" Cursor="Hand"/>
                        </DockPanel>
                    </Border>

                    <TabControl Grid.Row="1" Background="#FFFFFF" Margin="12">
                        <TabItem Header="General">
                            <StackPanel Margin="10">
                                <GroupBox Header="Default Download Directory" Margin="0,0,0,12" Padding="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding Settings.DefaultDownloadDirectory, UpdateSourceTrigger=PropertyChanged}" 
                                                 Background="#FFFFFF" Foreground="#212529" BorderBrush="#CED4DA" BorderThickness="1" Padding="6,4"/>
                                        <Button Grid.Column="1" Content="Browse..." Margin="6,0,0,0" Style="{StaticResource ClassicDialogBtn}" Click="OnBrowseSettingsFolderClick"/>
                                    </Grid>
                                </GroupBox>

                                <GroupBox Header="Preferences" Margin="0,0,0,10" Padding="10">
                                    <StackPanel>
                                        <CheckBox Content="Automatically open completed files" IsChecked="{Binding Settings.AutoOpenFileOnComplete}" Margin="0,0,0,8"/>
                                        <CheckBox Content="Confirm before deleting downloads" IsChecked="{Binding Settings.ConfirmBeforeDelete}"/>
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>
                        </TabItem>

                        <TabItem Header="Connection">
                            <StackPanel Margin="10">
                                <GroupBox Header="Connection Type / Speed" Margin="0,0,0,12" Padding="10">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock Text="Default max. connection number:" FontSize="11.5" Foreground="#495057" DockPanel.Dock="Left"/>
                                            <TextBlock Text="{Binding Settings.DefaultConnections, StringFormat='{}{0}'}" FontWeight="Bold" FontSize="11.5" Foreground="#0D6EFD" DockPanel.Dock="Right"/>
                                        </DockPanel>
                                        <Slider Minimum="1" Maximum="32" Value="{Binding Settings.DefaultConnections}" Margin="0,0,0,10"/>

                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock Text="Max Concurrent Downloads:" FontSize="11.5" Foreground="#495057" DockPanel.Dock="Left"/>
                                            <TextBlock Text="{Binding Settings.MaxConcurrentDownloads, StringFormat='{}{0}'}" FontWeight="Bold" FontSize="11.5" Foreground="#0D6EFD" DockPanel.Dock="Right"/>
                                        </DockPanel>
                                        <Slider Minimum="1" Maximum="10" Value="{Binding Settings.MaxConcurrentDownloads}" Margin="0,0,0,10"/>

                                        <CheckBox Content="Enable Dynamic Middle-Split Load Balancing (IDM Parity)" IsChecked="{Binding Settings.EnableDynamicMiddleSplit}"/>
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="Speed Limiter" Padding="10">
                                    <StackPanel>
                                        <CheckBox Content="Enable Speed Limiter" IsChecked="{Binding IsSpeedLimiterEnabled}" Margin="0,0,0,8"/>
                                        <DockPanel>
                                            <TextBlock Text="Maximum Download Speed:" FontSize="11.5" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding SpeedLimitKb, UpdateSourceTrigger=PropertyChanged}" Width="70" DockPanel.Dock="Right" Margin="6,0,0,0" Padding="4,2"/>
                                            <TextBlock Text="KB/s" FontSize="11.5" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
