<Window x:Class="Wdm.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Wdm.Ui.ViewModels"
        xmlns:ctl="clr-namespace:Wdm.Ui.Controls"
        Title="{Binding WindowTitle}" Height="740" Width="1180"
        MinHeight="560" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/app.png"
        Background="{DynamicResource ThemeWindowBg}"
        Foreground="{DynamicResource ThemeTextPrimary}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="12.5"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.BitmapScalingMode="HighQuality">

    <Window.DataContext>
        <vm:MainViewModel x:Name="ViewModel" />
    </Window.DataContext>

    <Grid>
        <DockPanel LastChildFill="True">

            <!-- ======================= COMMAND BAR ======================= -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource ThemeSurfaceBg}" BorderBrush="{DynamicResource ThemeBorder}"
                    BorderThickness="0,0,0,1" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Brand -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,18,0" VerticalAlignment="Center">
                        <Border Width="32" Height="32" CornerRadius="9" Background="{DynamicResource ThemeAccent}" TextElement.Foreground="{DynamicResource ThemeOnAccent}">
                            <Path Data="{StaticResource GeoDownload}" Style="{StaticResource Ico}" Width="17" Height="17" HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="WDM" FontSize="16" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextPrimary}"/>
                    </StackPanel>

                    <!-- Primary actions -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource AccentBtn}" Click="OnAddUrlClick" ToolTip="Add a download (Ctrl+N)" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoPlus}" Style="{StaticResource Ico}" Width="16" Height="16" />
                                <TextBlock Text="Add URL" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource CmdBtn}" Click="OnResumeClick" ToolTip="Resume the selected download" Margin="0,0,2,0" IsEnabled="{Binding CanResumeSelected}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource GeoPlay}" Style="{StaticResource Ico}" Width="16" Height="16" />
                            <TextBlock Text="Resume" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                        <Button Style="{StaticResource CmdBtn}" Click="OnPauseClick" ToolTip="Pause the selected download" Margin="0,0,2,0" IsEnabled="{Binding CanPauseSelected}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource GeoPause}" Style="{StaticResource Ico}" Width="16" Height="16" />
                            <TextBlock Text="Pause" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                        <Button Style="{StaticResource CmdBtn}" Click="OnDeleteClick" ToolTip="Remove the selected download (Del)" Margin="0,0,8,0" IsEnabled="{Binding HasSelection}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource GeoTrash}" Style="{StaticResource Ico}" Width="16" Height="16" />
                            <TextBlock Text="Delete" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                        <Rectangle Width="1" Height="20" Fill="{DynamicResource ThemeBorder}" Margin="0,0,10,0"/>
                        <Button Style="{StaticResource IconBtn}" Click="OnStartQueueClick" ToolTip="Start queue - run every unfinished download" Margin="0,0,2,0" AutomationProperties.Name="Start queue">
                        <Path Data="{StaticResource GeoQueuePlay}" Style="{StaticResource Ico}" Width="17" Height="17" />
                    </Button>
                        <Button Style="{StaticResource IconBtn}" Click="OnStopQueueClick" ToolTip="Stop queue - pause everything" Margin="0,0,2,0" AutomationProperties.Name="Stop queue">
                        <Path Data="{StaticResource GeoQueueStop}" Style="{StaticResource Ico}" Width="17" Height="17" />
                    </Button>
                    </StackPanel>

                    <!-- Search -->
                    <Border Grid.Column="3" Width="250" Height="34" Background="{DynamicResource ThemeSurfaceAltBg}" BorderBrush="{DynamicResource ThemeBorder}"
                            BorderThickness="1" CornerRadius="17" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="30"/>
                            </Grid.ColumnDefinitions>
                            <Path Data="{StaticResource GeoSearch}" Style="{StaticResource Ico}" Width="14" Height="14" HorizontalAlignment="Center"
                                  TextElement.Foreground="{DynamicResource ThemeTextMuted}"/>
                            <TextBox x:Name="SearchBox" Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent"
                                     BorderThickness="0" Padding="0,0,0,1" VerticalAlignment="Center" ToolTip="Search downloads (Ctrl+F)"/>
                            <TextBlock Grid.Column="1" Text="Search downloads" IsHitTestVisible="False" Foreground="{DynamicResource ThemeTextMuted}" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button Grid.Column="2" Style="{StaticResource IconBtn}" Width="26" Height="26" MinHeight="26" Click="OnClearSearchClick" ToolTip="Clear"
                                    Visibility="{Binding Text.Length, ElementName=SearchBox, Converter={StaticResource NotZeroToVis}}" AutomationProperties.Name="Clear">
                                <Path Data="{StaticResource GeoX}" Style="{StaticResource Ico}" Width="11" Height="11"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Tools -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconBtn}" Click="OnGrabberClick" ToolTip="Site grabber - find downloadable files on a page" Margin="0,0,2,0" AutomationProperties.Name="Site grabber">
                        <Path Data="{StaticResource GeoGlobe}" Style="{StaticResource Ico}" Width="17" Height="17" />
                    </Button>
                        <Button Style="{StaticResource IconBtn}" Click="OnSchedulerClick" ToolTip="Scheduler" Margin="0,0,2,0" AutomationProperties.Name="Scheduler">
                        <Path Data="{StaticResource GeoClock}" Style="{StaticResource Ico}" Width="17" Height="17" />
                    </Button>
                        <Button Style="{StaticResource IconBtn}" Click="OnToggleThemeClick" ToolTip="Switch light / dark theme" Margin="0,0,2,0" AutomationProperties.Name="Switch light / dark theme">
                            <Path Width="17" Height="17">
                                <Path.Style>
                                    <Style TargetType="Path" BasedOn="{StaticResource Ico}">
                                        <Setter Property="Data" Value="{StaticResource GeoMoon}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDarkMode}" Value="True">
                                                <Setter Property="Data" Value="{StaticResource GeoSun}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Button>
                        <Button Style="{StaticResource IconBtn}" Click="OnOpenSettingsClick" ToolTip="Options" Margin="0,0,2,0" AutomationProperties.Name="Options">
                        <Path Data="{StaticResource GeoSettings}" Style="{StaticResource Ico}" Width="17" Height="17" />
                    </Button>
                        <Button x:Name="MoreBtn" Style="{StaticResource IconBtn}" Click="OnMoreClick" ToolTip="More" AutomationProperties.Name="More">
                            <Path Data="{StaticResource GeoMore}" Style="{StaticResource Ico}" Width="17" Height="17" StrokeThickness="3"/>
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Add links from clipboard..." Click="OnBatchFromClipboardClick" >
                            <MenuItem.Icon>
                                <Path Data="{StaticResource GeoLayers}" Style="{StaticResource Ico}" Width="14" Height="14" />
                            </MenuItem.Icon>
                        </MenuItem>
                                    <MenuItem Header="Batch download..." Click="OnBatchDownloadClick" InputGestureText="Ctrl+B">
                            <MenuItem.Icon>
                                <Path Data="{StaticResource GeoList}" Style="{StaticResource Ico}" Width="14" Height="14" />
                            </MenuItem.Icon>
                        </MenuItem>
                                    <Separator/>
                                    <MenuItem Header="Pause all" Click="OnStopAllClick" >
                            <MenuItem.Icon>
                                <Path Data="{StaticResource GeoStop}" Style="{StaticResource Ico}" Width="14" Height="14" />
                            </MenuItem.Icon>
                        </MenuItem>
                                    <MenuItem Header="Remove completed" Click="OnDeleteCompletedClick" >
                            <MenuItem.Icon>
                                <Path Data="{StaticResource GeoCheckCircle}" Style="{StaticResource Ico}" Width="14" Height="14" />
                            </MenuItem.Icon>
                        </MenuItem>
                                    <Separator/>
                                    <MenuItem Header="Speed limit" IsCheckable="True" IsChecked="{Binding IsSpeedLimiterEnabled, Mode=TwoWay}"/>
                                    <MenuItem Header="Show connection details" IsCheckable="True" IsChecked="{Binding IsSegmentPanelVisible, Mode=TwoWay}"/>
                                    <Separator/>
                                    <MenuItem Header="About WDM" Click="OnAboutClick" >
                            <MenuItem.Icon>
                                <Path Data="{StaticResource GeoInfo}" Style="{StaticResource Ico}" Width="14" Height="14" />
                            </MenuItem.Icon>
                        </MenuItem>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ======================= STATUS BAR ======================= -->
            <Border DockPanel.Dock="Bottom" Background="{DynamicResource ThemeSurfaceBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,1,0,0" Height="30" Padding="16,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" TextElement.FontSize="11.5" TextElement.Foreground="{DynamicResource ThemeTextMuted}">
                        <TextBlock Text="{Binding AllCount, StringFormat='{}{0} downloads'}"/>
                        <TextBlock Text="  |  "/>
                        <TextBlock Text="{Binding ActiveDownloadsCount, StringFormat='{}{0} active'}"/>
                        <TextBlock Text="  |  "/>
                        <TextBlock Text="{Binding QueueStatusText}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" TextElement.FontSize="11.5">
                        <Path Data="{StaticResource GeoDownload}" Style="{StaticResource Ico}" Width="13" Height="13" StrokeThickness="2" TextElement.Foreground="{DynamicResource ThemeAccent}"/>
                        <TextBlock Text="{Binding TotalSpeedFormatted}" FontWeight="SemiBold" Margin="6,0,18,0" Foreground="{DynamicResource ThemeAccent}"/>
                        <Path Data="{StaticResource GeoStorage}" Style="{StaticResource Ico}" Width="13" Height="13" TextElement.Foreground="{DynamicResource ThemeTextMuted}"/>
                        <TextBlock Text="{Binding FreeDiskSpaceFormatted}" Margin="6,0,0,0" Foreground="{DynamicResource ThemeTextMuted}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ======================= SIDEBAR ======================= -->
            <Border DockPanel.Dock="Left" Width="226" Background="{DynamicResource ThemeSidebarBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,14,12,8">
                        <StackPanel>
                            <TextBlock Text="LIBRARY" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource ThemeTextMuted}" Margin="10,0,0,6"/>
                            <RadioButton Style="{StaticResource NavItem}" GroupName="Nav"
                                     IsChecked="{Binding SelectedCategory, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter=All Downloads}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Path Data="{StaticResource GeoList}" Style="{StaticResource Ico}" Width="15" Height="15" />
                                <TextBlock Grid.Column="1" Text="All downloads" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding AllCount}" FontSize="11" Opacity="0.65" VerticalAlignment="Center"/>
                            </Grid>
                        </RadioButton>
                            <RadioButton Style="{StaticResource NavItem}" GroupName="Nav"
                                     IsChecked="{Binding SelectedCategory, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter=Unfinished}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Path Data="{StaticResource GeoUnfinished}" Style="{StaticResource Ico}" Width="15" Height="15" />
                                <TextBlock Grid.Column="1" Text="Unfinished" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding UnfinishedCount}" FontSize="11" Opacity="0.65" VerticalAlignment="Center"/>
                            </Grid>
                        </RadioButton>
                            <RadioButton Style="{StaticResource NavItem}" GroupName="Nav"
                                     IsChecked="{Binding SelectedCategory, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter=Finished}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Path Data="{StaticResource GeoCheckCircle}" Style="{StaticResource Ico}" Width="15" Height="15" />
                                <TextBlock Grid.Column="1" Text="Finished" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding FinishedCount}" FontSize="11" Opacity="0.65" VerticalAlignment="Center"/>
                            </Grid>
                        </RadioButton>

                            <TextBlock Text="FILE TYPES" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource ThemeTextMuted}" Margin="10,18,0,6"/>
                            <RadioButton Style="{StaticResource NavItem}" GroupName="Nav"
                                     IsChecked="{Binding SelectedCategory, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter=Compressed}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Path Data="{StaticResource GeoArchive}" Style="{StaticResource Ico}" Width="15" Height="15" />
                                <TextBlock Grid.Column="1" Text="Compressed" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding CompressedCount}" FontSize="11" Opacity="0.65" VerticalAlignment="Center"/>
                            </Grid>
                        </RadioButton>
                            <RadioButton Style="{StaticResource NavItem}" GroupName="Nav"
                                     IsChecked="{Binding SelectedCategory, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter=Documents}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Path Data="{StaticResource GeoDocument}" Style="{StaticResource Ico}" Width="15" Height="15" />
                                <TextBlock Grid.Column="1" Text="Documents" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding DocumentsCount}" FontSize="11" Opacity="0.65" VerticalAlignment="Center"/>
                            </Grid>
                        </RadioButton>
                            <RadioButton Style="{StaticResource NavItem}" GroupName="Nav"
                                     IsChecked="{Binding SelectedCategory, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter=Music}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Path Data="{StaticResource GeoMusic}" Style="{StaticResource Ico}" Width="15" Height="15" />
                                <TextBlock Grid.Column="1" Text="Music" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding MusicCount}" FontSize="11" Opacity="0.65" VerticalAlignment="Center"/>
                            </Grid>
                        </RadioButton>
                            <RadioButton Style="{StaticResource NavItem}" GroupName="Nav"
                                     IsChecked="{Binding SelectedCategory, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter=Programs}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Path Data="{StaticResource GeoProgram}" Style="{StaticResource Ico}" Width="15" Height="15" />
                                <TextBlock Grid.Column="1" Text="Programs" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding ProgramsCount}" FontSize="11" Opacity="0.65" VerticalAlignment="Center"/>
                            </Grid>
                        </RadioButton>
                            <RadioButton Style="{StaticResource NavItem}" GroupName="Nav"
                                     IsChecked="{Binding SelectedCategory, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter=Video}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Path Data="{StaticResource GeoVideo}" Style="{StaticResource Ico}" Width="15" Height="15" />
                                <TextBlock Grid.Column="1" Text="Video" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding VideoCount}" FontSize="11" Opacity="0.65" VerticalAlignment="Center"/>
                            </Grid>
                        </RadioButton>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Queue card -->
                    <Border Grid.Row="1" Margin="12" Padding="12,10" CornerRadius="10" Background="{DynamicResource ThemeSurfaceBg}"
                            BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource ThemeBorderStrong}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsQueueActive}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource ThemeSuccess}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding QueueStatusText}" FontWeight="SemiBold" Margin="8,0,0,0" Foreground="{DynamicResource ThemeTextPrimary}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding FreeDiskSpaceFormatted}" FontSize="11.5" Margin="0,6,0,0" Foreground="{DynamicResource ThemeTextMuted}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ======================= CONNECTION DETAILS ======================= -->
            <Grid DockPanel.Dock="Bottom" Visibility="{Binding IsSegmentPanelVisible, Converter={StaticResource BoolToVis}}">
                <Border Background="{DynamicResource ThemeSurfaceBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,1,0,0" Height="132" Padding="16,10,16,6"
                        Visibility="{Binding SelectedDownload, Converter={StaticResource NotNullToVis}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="{Binding SelectedDownload.Segments.Count, StringFormat='{}Connections: {0}'}" DockPanel.Dock="Right"
                                       Foreground="{DynamicResource ThemeTextMuted}" FontSize="11.5"/>
                            <TextBlock Text="{Binding SelectedDownload.FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,16,0"/>
                        </DockPanel>
                        <TextBlock Grid.Row="1" Text="{Binding SelectedDownload.ErrorText}" TextWrapping="Wrap" FontSize="12.5"
                                   Foreground="{DynamicResource ThemeDanger}" VerticalAlignment="Top" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedDownload.IsError}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding SelectedDownload.Segments}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource ThemeSurfaceAltBg}" CornerRadius="8" Margin="0,0,8,8" Padding="10,7" Width="176">
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock Text="{Binding Percentage, StringFormat='{}{0:F0}%'}" FontSize="11" FontWeight="SemiBold" DockPanel.Dock="Right"
                                                               Foreground="{DynamicResource ThemeAccent}"/>
                                                    <TextBlock Text="{Binding SegmentIndex, StringFormat='Connection {0}'}" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}"/>
                                                </DockPanel>
                                                <ProgressBar Style="{StaticResource SlimProgress}" Height="4" Value="{Binding Percentage, Mode=OneWay}" Margin="0,6"/>
                                                <TextBlock Text="{Binding FormattedSpeed}" FontSize="10.5" Foreground="{DynamicResource ThemeTextMuted}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- ======================= DOWNLOAD LIST ======================= -->
            <DockPanel Background="{DynamicResource ThemeSurfaceBg}">

                <!-- Filters -->
                <Border DockPanel.Dock="Top" Padding="16,10" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource CmdBtn}" Click="OnToggleSpeedLimiterClick" MinHeight="28" Padding="10,0"
                                ToolTip="Click to turn the speed limit on or off">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoBolt}" Style="{StaticResource Ico}" Width="13" Height="13" />
                                <TextBlock Margin="7,0,0,0" FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="No speed limit"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSpeedLimiterEnabled}" Value="True">
                                                    <Setter Property="Text" Value="{Binding SpeedLimitKb, StringFormat='Limit {0} KB/s'}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource ThemeWarning}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="All" Style="{StaticResource Chip}" GroupName="Filter" Margin="0,0,4,0"
                                         IsChecked="{Binding ActiveFilterTag, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter=All}"/>
                            <RadioButton Content="Active" Style="{StaticResource Chip}" GroupName="Filter" Margin="0,0,4,0"
                                         IsChecked="{Binding ActiveFilterTag, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter=Active}"/>
                            <RadioButton Content="Completed" Style="{StaticResource Chip}" GroupName="Filter" Margin="0,0,4,0"
                                         IsChecked="{Binding ActiveFilterTag, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter=Completed}"/>
                            <RadioButton Content="Paused" Style="{StaticResource Chip}" GroupName="Filter" Margin="0,0,4,0"
                                         IsChecked="{Binding ActiveFilterTag, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter=Paused}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Clipboard banner -->
                <Border DockPanel.Dock="Top" Background="{DynamicResource ThemeAccentSoft}" Padding="16,8"
                        Visibility="{Binding IsClipboardBannerVisible, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconBtn}" Width="28" Height="28" MinHeight="28" Click="OnDismissClipboardBannerClick" ToolTip="Dismiss" AutomationProperties.Name="Dismiss">
                            <Path Data="{StaticResource GeoX}" Style="{StaticResource Ico}" Width="12" Height="12"/>
                        </Button>
                        <Button DockPanel.Dock="Right" Content="Download" Style="{StaticResource BtnPrimary}" MinWidth="90" MinHeight="28" Margin="12,0,6,0" Click="OnDownloadClipboardBannerClick"/>
                        <StackPanel Orientation="Horizontal" TextElement.Foreground="{DynamicResource ThemeAccent}">
                            <Path Data="{StaticResource GeoCopy}" Style="{StaticResource Ico}" Width="15" Height="15" />
                            <TextBlock Text="Link on clipboard" FontWeight="SemiBold" Margin="10,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ClipboardBannerUrl}" TextTrimming="CharacterEllipsis" MaxWidth="560" VerticalAlignment="Center" Opacity="0.85"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Grid>
                    <DataGrid x:Name="DownloadsGrid" ItemsSource="{Binding FilteredDownloads}"
                              SelectedItem="{Binding SelectedDownload, Mode=TwoWay}"
                              MouseDoubleClick="OnDownloadsGridMouseDoubleClick"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                              CanUserSortColumns="False" CanUserResizeRows="False"
                              GridLinesVisibility="None" BorderThickness="0" Background="Transparent"
                              SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column"
                              RowHeight="58" ColumnHeaderHeight="34"
                              EnableRowVirtualization="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              FocusVisualStyle="{x:Null}">

                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Resume" Click="OnResumeClick" >
                            <MenuItem.Icon>
                                <Path Data="{StaticResource GeoPlay}" Style="{StaticResource Ico}" Width="14" Height="14" />
                            </MenuItem.Icon>
                        </MenuItem>
                                <MenuItem Header="Pause" Click="OnPauseClick" >
                            <MenuItem.Icon>
                                <Path Data="{StaticResource GeoPause}" Style="{StaticResource Ico}" Width="14" Height="14" />
                            </MenuItem.Icon>
                        </MenuItem>
                                <MenuItem Header="Download again" Click="OnRedownloadClick" >
                            <MenuItem.Icon>
                                <Path Data="{StaticResource GeoRefresh}" Style="{StaticResource Ico}" Width="14" Height="14" />
                            </MenuItem.Icon>
                        </MenuItem>
                                <Separator/>
                                <MenuItem Header="Move up" Click="OnMoveUpClick" InputGestureText="Alt+Up">
                            <MenuItem.Icon>
                                <Path Data="{StaticResource GeoChevronUp}" Style="{StaticResource Ico}" Width="14" Height="14" />
                            </MenuItem.Icon>
                        </MenuItem>
                                <MenuItem Header="Move down" Click="OnMoveDownClick" InputGestureText="Alt+Down">
                            <MenuItem.Icon>
                                <Path Data="{StaticResource GeoChevronDown}" Style="{StaticResource Ico}" Width="14" Height="14" />
                            </MenuItem.Icon>
                        </MenuItem>
                                <Separator/>
                                <MenuItem Header="Open file" Click="OnOpenFileClick" >
                            <MenuItem.Icon>
                                <Path Data="{StaticResource GeoFile}" Style="{StaticResource Ico}" Width="14" Height="14" />
                            </MenuItem.Icon>
                        </MenuItem>
                                <MenuItem Header="Show in folder" Click="OnOpenFileLocationClick" >
                            <MenuItem.Icon>
                                <Path Data="{StaticResource GeoFolder}" Style="{StaticResource Ico}" Width="14" Height="14" />
                            </MenuItem.Icon>
                        </MenuItem>
                                <MenuItem Header="Copy address" Click="OnCopyUrlClick" >
                            <MenuItem.Icon>
                                <Path Data="{StaticResource GeoCopy}" Style="{StaticResource Ico}" Width="14" Height="14" />
                            </MenuItem.Icon>
                        </MenuItem>
                                <MenuItem Header="Properties" Click="OnPropertiesClick" >
                            <MenuItem.Icon>
                                <Path Data="{StaticResource GeoInfo}" Style="{StaticResource Ico}" Width="14" Height="14" />
                            </MenuItem.Icon>
                        </MenuItem>
                                <Separator/>
                                <MenuItem Header="Remove from list" Click="OnDeleteClick" >
                            <MenuItem.Icon>
                                <Path Data="{StaticResource GeoX}" Style="{StaticResource Ico}" Width="14" Height="14" />
                            </MenuItem.Icon>
                        </MenuItem>
                                <MenuItem Header="Delete file from disk" Click="OnDeleteFileFromDiskClick" >
                            <MenuItem.Icon>
                                <Path Data="{StaticResource GeoTrash}" Style="{StaticResource Ico}" Width="14" Height="14" />
                            </MenuItem.Icon>
                        </MenuItem>
                            </ContextMenu>
                        </DataGrid.ContextMenu>

                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="NAME" Width="2.4*" MinWidth="240">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="38" Height="38" CornerRadius="10" Background="{Binding FileTileBrush}" Margin="0,0,12,0">
                                                <Path Data="{Binding FileIconGeometry}" Style="{StaticResource Ico}" Width="18" Height="18" Stroke="{Binding FileIconBrush}" HorizontalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center" MaxWidth="360">
                                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}"/>
                                                <TextBlock Text="{Binding Domain}" FontSize="11.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource ThemeTextMuted}" ToolTip="{Binding Url}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="PROGRESS" Width="1.5*" MinWidth="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <DockPanel Margin="0,0,0,6">
                                                <TextBlock Text="{Binding SizeFormatted}" DockPanel.Dock="Right" FontSize="11.5" Foreground="{DynamicResource ThemeTextMuted}"/>
                                                <TextBlock Text="{Binding FormattedPercentage}" FontWeight="SemiBold" FontSize="12"/>
                                            </DockPanel>
                                            <ProgressBar Style="{StaticResource SlimProgress}" Value="{Binding ProgressPercentage}" Foreground="{Binding StatusColor}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="SPEED" Width="96">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center" Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding SpeedFormatted}" FontWeight="SemiBold" FontSize="12"/>
                                            <TextBlock Text="{Binding TimeLeftFormatted, StringFormat='{}{0} left'}" FontSize="11" Margin="0,2,0,0" Foreground="{DynamicResource ThemeTextMuted}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="STATUS" Width="136">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding StatusBadgeBackground}" CornerRadius="11" Padding="9,3" HorizontalAlignment="Left" ToolTip="{Binding StatusToolTip}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="6" Height="6" Fill="{Binding StatusColor}" Margin="0,1,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding StatusLabel}" Foreground="{Binding StatusColor}" FontSize="11.5" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="ADDED" Width="132">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding LastTryDate}" FontSize="11.5" Foreground="{DynamicResource ThemeTextMuted}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Empty state -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="360"
                                Visibility="{Binding HasNoDownloads, Converter={StaticResource BoolToVis}}">
                        <Border Width="72" Height="72" CornerRadius="36" Background="{DynamicResource ThemeAccentSoft}" HorizontalAlignment="Center" Margin="0,0,0,16"
                                TextElement.Foreground="{DynamicResource ThemeAccent}">
                            <Path Data="{StaticResource GeoDownload}" Style="{StaticResource Ico}" Width="30" Height="30" HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Nothing here yet" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"
                                   Visibility="{Binding IsLibraryEmpty, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="No downloads match this view" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"
                                   Visibility="{Binding IsLibraryEmpty, Converter={StaticResource InvBoolToVis}}"/>
                        <TextBlock Text="Paste a link, drop one onto this window, or let the browser extension send downloads here."
                                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,18" Foreground="{DynamicResource ThemeTextMuted}"
                                   Visibility="{Binding IsLibraryEmpty, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="Add URL" Style="{StaticResource BtnPrimary}" HorizontalAlignment="Center" Click="OnAddUrlClick"
                                Visibility="{Binding IsLibraryEmpty, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Grid>
            </DockPanel>
        </DockPanel>

        <Grid Style="{StaticResource ModalOverlay}" Visibility="{Binding IsAddModalOpen, Converter={StaticResource BoolToVis}}">
            <ctl:DialogCard Width="540" Title="Add download" Icon="{StaticResource GeoDownload}" CloseClick="OnCancelModalClick">
                
                <StackPanel>
                    <Border Background="{DynamicResource ThemeAccentSoft}" CornerRadius="8" Padding="12,9" Margin="0,0,0,14"
                            Visibility="{Binding IsYouTubeUrl, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal" TextElement.Foreground="{DynamicResource ThemeAccent}">
                            <Path Data="{StaticResource GeoVideo}" Style="{StaticResource Ico}" Width="16" Height="16" />
                            <TextBlock Text="Video page detected - the best available quality will be downloaded." Margin="10,0,0,0" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Address" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,6"/>
                    <TextBox x:Name="AddUrlBox" Text="{Binding NewDownloadUrl, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Download address"/>
                    <TextBlock Text="Enter a full http:// or https:// address" Foreground="{DynamicResource ThemeDanger}" FontSize="11.5" Margin="2,5,0,0"
                               Visibility="{Binding ShowUrlError, Converter={StaticResource BoolToVis}}"/>

                    <TextBlock Text="Save to" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,14,0,6"/>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding NewDownloadDir, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="1" Content="Browse" Margin="8,0,0,0" Style="{StaticResource BtnSecondary}" MinWidth="80" Click="OnBrowseFolderClick"/>
                    </Grid>

                    <TextBlock Text="SHA-256 (optional)" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding NewDownloadSha256, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Expected SHA-256 checksum"
                             ToolTip="If you know the file's SHA-256, WDM checks it after the download and will not publish a file that does not match"/>
                    <TextBlock Text="Enter 64 hexadecimal characters, or leave empty" Foreground="{DynamicResource ThemeDanger}" FontSize="11.5" Margin="2,5,0,0"
                               Visibility="{Binding ShowSha256Error, Converter={StaticResource BoolToVis}}"/>
                    <Border Height="14"/>

                    <DockPanel Margin="0,0,0,2">
                            <TextBlock Text="{Binding NewDownloadConnections, StringFormat='{}{0}'}" FontWeight="SemiBold" Foreground="{DynamicResource ThemeAccent}" DockPanel.Dock="Right"/>
                            <TextBlock Text="Connections" Foreground="{DynamicResource ThemeTextSecondary}"/>
                        </DockPanel>
                        <Slider Minimum="1" Maximum="32" Value="{Binding NewDownloadConnections}" Margin="0,0,0,10" SmallChange="1" TickFrequency="1" IsSnapToTickEnabled="True"/>
                </StackPanel>
                <ctl:DialogCard.Footer>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Style="{StaticResource BtnSecondary}" Click="OnCancelModalClick"/>
                        <Button Content="Download" Style="{StaticResource BtnPrimary}" Margin="10,0,0,0" Click="OnConfirmModalClick"
                                IsDefault="True" IsEnabled="{Binding CanConfirmAdd}"/>
                    </StackPanel>
                </ctl:DialogCard.Footer>
            </ctl:DialogCard>
        </Grid>

        <Grid Style="{StaticResource ModalOverlay}" Visibility="{Binding IsSettingsModalOpen, Converter={StaticResource BoolToVis}}">
            <ctl:DialogCard Width="580" Title="Options" Icon="{StaticResource GeoSettings}" CloseClick="OnCancelSettingsClick">
                
                <TabControl>
                    <TabItem Header="General">
                        <StackPanel>
                            <GroupBox Header="DEFAULT DOWNLOAD FOLDER" Padding="14" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding Settings.DefaultDownloadDirectory, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Grid.Column="1" Content="Browse" Margin="8,0,0,0" Style="{StaticResource BtnSecondary}" MinWidth="80" Click="OnBrowseSettingsFolderClick"/>
                                </Grid>
                            </GroupBox>
                            <GroupBox Header="BEHAVIOUR" Padding="14">
                                <StackPanel>
                                    <CheckBox Content="Open files automatically when they finish" IsChecked="{Binding Settings.AutoOpenFileOnComplete}" Margin="0,0,0,12"/>
                                    <CheckBox Content="Ask before deleting downloads" IsChecked="{Binding Settings.ConfirmBeforeDelete}" Margin="0,0,0,12"/>
                                    <CheckBox Content="Show the add-download dialog for browser downloads" IsChecked="{Binding Settings.ShowStartDownloadDialog}"/>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="Connection">
                        <StackPanel>
                            <GroupBox Header="PERFORMANCE" Padding="14" Margin="0,0,0,14">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,2">
                            <TextBlock Text="{Binding Settings.DefaultConnections, StringFormat='{}{0}'}" FontWeight="SemiBold" Foreground="{DynamicResource ThemeAccent}" DockPanel.Dock="Right"/>
                            <TextBlock Text="Connections per download" Foreground="{DynamicResource ThemeTextSecondary}"/>
                        </DockPanel>
                        <Slider Minimum="1" Maximum="32" Value="{Binding Settings.DefaultConnections}" Margin="0,0,0,10" SmallChange="1" TickFrequency="1" IsSnapToTickEnabled="True"/>
                                    <DockPanel Margin="0,0,0,2">
                            <TextBlock Text="{Binding Settings.MaxConcurrentDownloads, StringFormat='{}{0}'}" FontWeight="SemiBold" Foreground="{DynamicResource ThemeAccent}" DockPanel.Dock="Right"/>
                            <TextBlock Text="Simultaneous downloads" Foreground="{DynamicResource ThemeTextSecondary}"/>
                        </DockPanel>
                        <Slider Minimum="1" Maximum="10" Value="{Binding Settings.MaxConcurrentDownloads}" Margin="0,0,0,10" SmallChange="1" TickFrequency="1" IsSnapToTickEnabled="True"/>
                                    <DockPanel Margin="0,0,0,2">
                            <TextBlock Text="{Binding Settings.NetworkTimeoutSeconds, StringFormat='{}{0} s'}" FontWeight="SemiBold" Foreground="{DynamicResource ThemeAccent}" DockPanel.Dock="Right"/>
                            <TextBlock Text="Stalled connection timeout" Foreground="{DynamicResource ThemeTextSecondary}"/>
                        </DockPanel>
                        <Slider Minimum="5" Maximum="120" Value="{Binding Settings.NetworkTimeoutSeconds}" Margin="0,0,0,10" SmallChange="1" TickFrequency="1" IsSnapToTickEnabled="True"/>
                                    <CheckBox Content="Split active segments to keep every connection busy" IsChecked="{Binding Settings.EnableDynamicMiddleSplit}"/>
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="SPEED LIMIT" Padding="14">
                                <StackPanel>
                                    <CheckBox Content="Limit total download speed" IsChecked="{Binding IsSpeedLimiterEnabled}" Margin="0,0,0,12"/>
                                    <DockPanel>
                                        <TextBlock Text="KB/s" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource ThemeTextMuted}"/>
                                        <TextBox Text="{Binding SpeedLimitKb, UpdateSourceTrigger=PropertyChanged}" Width="100" DockPanel.Dock="Right"/>
                                        <TextBlock Text="Maximum speed" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextSecondary}"/>
                                    </DockPanel>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="Network">
                        <GroupBox Header="USER AGENT" Padding="14">
                            <StackPanel>
                                <TextBox Text="{Binding Settings.UserAgent, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="False"/>
                                <TextBlock Text="Sent with every request unless the browser supplies its own." FontSize="11.5" Margin="2,8,0,0" Foreground="{DynamicResource ThemeTextMuted}"/>
                            </StackPanel>
                        </GroupBox>
                    </TabItem>
                </TabControl>
                <ctl:DialogCard.Footer>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Style="{StaticResource BtnSecondary}" Click="OnCancelSettingsClick"/>
                        <Button Content="Save" Style="{StaticResource BtnPrimary}" Margin="10,0,0,0" Click="OnSaveSettingsClick" IsDefault="True"/>
                    </StackPanel>
                </ctl:DialogCard.Footer>
            </ctl:DialogCard>
        </Grid>

        <Grid Style="{StaticResource ModalOverlay}" Visibility="{Binding IsSchedulerModalOpen, Converter={StaticResource BoolToVis}}">
            <ctl:DialogCard Width="500" Title="Scheduler" Icon="{StaticResource GeoClock}" CloseClick="OnCancelSchedulerClick">
                
                <StackPanel>
                    <GroupBox Header="QUEUE TIMER" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <CheckBox Content="Run the queue on a schedule" IsChecked="{Binding SchedulerEnabled}" Margin="0,0,0,14"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Start at" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextSecondary}"/>
                                <TextBox Grid.Column="1" Text="{Binding SchedulerStartTime, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Stop at" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextSecondary}"/>
                                <TextBox Grid.Column="1" Text="{Binding SchedulerStopTime, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="24-hour format, for example 02:00 or 18:30." FontSize="11.5" Margin="0,10,0,0" Foreground="{DynamicResource ThemeTextMuted}"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="WHEN FINISHED" Padding="14">
                        <CheckBox Content="Shut down the computer when the queue completes" IsChecked="{Binding SchedulerShutdownOnComplete}"/>
                    </GroupBox>
                </StackPanel>
                <ctl:DialogCard.Footer>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Style="{StaticResource BtnSecondary}" Click="OnCancelSchedulerClick"/>
                        <Button Content="Save" Style="{StaticResource BtnPrimary}" Margin="10,0,0,0" Click="OnSaveSchedulerClick" IsDefault="True"/>
                    </StackPanel>
                </ctl:DialogCard.Footer>
            </ctl:DialogCard>
        </Grid>

        <Grid Style="{StaticResource ModalOverlay}" Visibility="{Binding IsGrabberModalOpen, Converter={StaticResource BoolToVis}}">
            <ctl:DialogCard Width="720" Title="Site grabber" Icon="{StaticResource GeoGlobe}" CloseClick="OnCancelGrabberClick">
                
                <StackPanel>
                    <TextBlock Text="Page address" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="GrabberBox" Text="{Binding GrabberUrl, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="1" Content="Scan page" Margin="8,0,0,0" Style="{StaticResource BtnPrimary}" MinWidth="100"
                                Click="OnAnalyzeGrabberClick" IsEnabled="{Binding IsGrabberBusy, Converter={StaticResource InvBool}}"/>
                    </Grid>
                    <TextBlock Text="{Binding GrabberStatusText}" FontSize="12" Foreground="{DynamicResource ThemeTextMuted}" Margin="2,0,0,10" TextWrapping="Wrap"/>
                    <Border BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="10" Height="250" ClipToBounds="True">
                        <DataGrid ItemsSource="{Binding GrabberItems}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  HeadersVisibility="Column" GridLinesVisibility="None" BorderThickness="0" Background="Transparent"
                                  SelectionMode="Single" RowHeight="34" VerticalScrollBarVisibility="Auto" CanUserSortColumns="False">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="" Binding="{Binding IsSelected, Mode=TwoWay}" Width="44"/>
                                <DataGridTextColumn Header="NAME" Binding="{Binding FileName}" Width="220" IsReadOnly="True"/>
                                <DataGridTextColumn Header="TYPE" Binding="{Binding Extension}" Width="64" IsReadOnly="True"/>
                                <DataGridTextColumn Header="CATEGORY" Binding="{Binding Category}" Width="96" IsReadOnly="True"/>
                                <DataGridTextColumn Header="ADDRESS" Binding="{Binding Url}" Width="*" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </StackPanel>
                <ctl:DialogCard.Footer>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Close" Style="{StaticResource BtnSecondary}" Click="OnCancelGrabberClick"/>
                        <Button Content="Download selected" Style="{StaticResource BtnPrimary}" Margin="10,0,0,0" Click="OnAddGrabbedClick"/>
                    </StackPanel>
                </ctl:DialogCard.Footer>
            </ctl:DialogCard>
        </Grid>

        <Grid Style="{StaticResource ModalOverlay}" Visibility="{Binding IsPropertiesModalOpen, Converter={StaticResource BoolToVis}}">
            <ctl:DialogCard Width="540" Title="Download properties" Icon="{StaticResource GeoInfo}" CloseClick="OnClosePropertiesClick">
                
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Name" Foreground="{DynamicResource ThemeTextMuted}" VerticalAlignment="Top"/>
                    <TextBlock Grid.Column="1" Text="{Binding PropertiesItem.FileName}" Foreground="{DynamicResource ThemeTextPrimary}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                </Grid>
                    <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Status" Foreground="{DynamicResource ThemeTextMuted}" VerticalAlignment="Top"/>
                    <TextBlock Grid.Column="1" Text="{Binding PropertiesItem.StatusLabel}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{Binding PropertiesItem.StatusColor}"/>
                </Grid>
                    <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Size" Foreground="{DynamicResource ThemeTextMuted}" VerticalAlignment="Top"/>
                    <TextBlock Grid.Column="1" Text="{Binding PropertiesItem.SizeFormatted}" Foreground="{DynamicResource ThemeTextPrimary}" TextWrapping="Wrap" />
                </Grid>
                    <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Saved to" Foreground="{DynamicResource ThemeTextMuted}" VerticalAlignment="Top"/>
                    <TextBlock Grid.Column="1" Text="{Binding PropertiesItem.TargetFilePath}" Foreground="{DynamicResource ThemeTextPrimary}" TextWrapping="Wrap" />
                </Grid>
                    <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Address" Foreground="{DynamicResource ThemeTextMuted}" VerticalAlignment="Top"/>
                    <TextBox Grid.Column="1" Text="{Binding PropertiesItem.Url, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Padding="8,6"/>
                </Grid>
                    <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Last try" Foreground="{DynamicResource ThemeTextMuted}" VerticalAlignment="Top"/>
                    <TextBlock Grid.Column="1" Text="{Binding PropertiesItem.LastTryDate}" TextWrapping="Wrap" Foreground="{DynamicResource ThemeTextMuted}"/>
                </Grid>
                </StackPanel>
                <ctl:DialogCard.Footer>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Close" Style="{StaticResource BtnSecondary}" Click="OnClosePropertiesClick"/>
                        <Button Content="Show in folder" Style="{StaticResource BtnPrimary}" Margin="10,0,0,0" Click="OnOpenFileLocationClick"/>
                    </StackPanel>
                </ctl:DialogCard.Footer>
            </ctl:DialogCard>
        </Grid>

        <Grid Style="{StaticResource ModalOverlay}" Visibility="{Binding IsBatchModalOpen, Converter={StaticResource BoolToVis}}">
            <ctl:DialogCard Width="600" Title="Batch download" Icon="{StaticResource GeoLayers}" CloseClick="OnCancelBatchClick">
                
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <Button Content="Paste links from clipboard" Style="{StaticResource CmdBtn}" DockPanel.Dock="Right" MinHeight="28"
                                Foreground="{DynamicResource ThemeAccent}" FontSize="12" Click="OnExtractBatchClipboardClick"/>
                        <TextBlock Text="One address per line" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0"/>
                    </DockPanel>
                    <TextBox x:Name="BatchBox" Text="{Binding BatchUrlsText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" Height="170" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12"
                             VerticalContentAlignment="Top" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto"/>
                    <TextBlock Text="{Binding BatchUrlCount, StringFormat='{}{0} valid addresses'}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource ThemeSuccess}" Margin="2,8,0,14"/>
                    <TextBlock Text="Save to" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding NewDownloadDir, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="1" Content="Browse" Margin="8,0,0,0" Style="{StaticResource BtnSecondary}" MinWidth="80" Click="OnBrowseFolderClick"/>
                    </Grid>
                </StackPanel>
                <ctl:DialogCard.Footer>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Style="{StaticResource BtnSecondary}" Click="OnCancelBatchClick"/>
                        <Button Content="Start downloads" Style="{StaticResource BtnPrimary}" Margin="10,0,0,0" Click="OnConfirmBatchClick"
                                IsEnabled="{Binding HasBatchUrls}"/>
                    </StackPanel>
                </ctl:DialogCard.Footer>
            </ctl:DialogCard>
        </Grid>
    </Grid>
</Window>
